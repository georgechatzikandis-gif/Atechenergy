---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import WhyChooseUs from "../components/WhyChooseUs.astro";
import About from "../components/About.astro";
import Coverage from "../components/Coverage.astro";
import Process from "../components/Process.astro";
import FAQ from "../components/FAQ.astro";
import ContactCTA from "../components/ContactCTA.astro";
import Footer from "../components/Footer.astro";
import LithiumValleyHero from "../components/LithiumValleyHero.astro";

const title = "Alphatech Energy | Φωτοβολταϊκά Πάνελ, Inverters & Μπαταρίες";
const description =
  "Επίσημος αντιπρόσωπος και διανομέας φωτοβολταϊκών πάνελ, inverters, μπαταριών αποθήκευσης και φορτιστών EV για Ευρώπη και Λατινική Αμερική. Αξιόπιστες ενεργειακές λύσεις από το 2008.";
---

<BaseLayout title={title} description={description}>
  <Header />
  <main>
    <Hero />
    <LithiumValleyHero />
    <WhyChooseUs />
    <About />
    <Coverage />
    <Process />
    <FAQ />
    <ContactCTA />
  </main>
  <Footer />
</BaseLayout>
