---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import BackToTop from "../../../components/BackToTop.astro";
import { withBase } from "../../../lib/paths";

const title = "Inverters | Alphatech Energy";
const description = "Grid & Hybrid Inverters από κορυφαίους κατασκευαστές για κάθε τύπο φωτοβολταϊκού έργου.";
---

<BaseLayout title={title} description={description} path="/products/grid-hybrid-inverters/">
  <Header />
  <main class="pt-24">

    {/* ── Breadcrumb ── */}
    <div class="border-b border-navy-900/8 bg-white">
      <div class="container-page py-4">
        <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-2 text-sm text-navy-900/50">
          <a href={withBase("")} class="hover:text-azure-600">Αρχική</a>
          <span aria-hidden="true">/</span>
          <a href={withBase("products/")} class="hover:text-azure-600">Προϊόντα</a>
          <span aria-hidden="true">/</span>
          <span class="font-medium text-navy-900">Inverters</span>
        </nav>
      </div>
    </div>

    {/* ── Hero ── */}
    <section class="bg-gradient-to-b from-white to-ice-100/40 py-16 sm:py-20">
      <div class="container-page grid gap-12 lg:grid-cols-2 lg:items-center">
        <div class="overflow-hidden rounded-[2rem] border border-navy-900/8 bg-white shadow-card flex items-center justify-center p-10" data-reveal>
          <svg class="h-48 w-auto text-navy-900/10" viewBox="0 0 120 80" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <rect x="10" y="10" width="100" height="60" rx="4"/>
            <circle cx="60" cy="40" r="20"/>
            <path d="M40 40h40M60 20v40"/>
          </svg>
        </div>

        <div data-reveal>
          <p class="text-xs font-bold tracking-[0.14em] text-azure-600 uppercase">Grid &amp; Hybrid Inverters</p>
          <h1 class="mt-3 font-display text-3xl font-extrabold tracking-tight text-navy-900 sm:text-4xl xl:text-5xl 2xl:text-6xl">
            Inverters
          </h1>
          <p class="mt-5 text-lg leading-relaxed text-navy-900/60">
            Αξιόπιστοι μετατροπείς ισχύος από κορυφαίους κατασκευαστές, για κάθε τύπο φωτοβολταϊκού έργου. Οικιακά, εμπορικά και βιομηχανικά συστήματα.
          </p>

          <ul class="mt-6 space-y-2.5">
            {[
              "On-grid, off-grid και hybrid λύσεις",
              "Τριφασικοί inverters υψηλής ισχύος",
              "Ενσωματωμένο BMS & έξυπνη διαχείριση ενέργειας",
              "Παρακολούθηση μέσω WiFi, Bluetooth & RS485",
              "Υψηλή απόδοση έως 97.8%",
              "Τεχνική υποστήριξη & εγγύηση",
            ].map((f) => (
              <li class="flex items-start gap-2.5 text-sm font-medium text-navy-900/75">
                <svg class="mt-0.5 h-4 w-4 shrink-0 text-azure-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                </svg>
                {f}
              </li>
            ))}
          </ul>

          <div class="mt-8 flex flex-wrap gap-4">
            <a href={withBase("#contact")} class="btn btn-primary">Ζητήστε Προσφορά</a>
          </div>
        </div>
      </div>
    </section>

    {/* ── CTA ── */}
    <section class="bg-white py-16 sm:py-20">
      <div class="container-page">
        <div class="overflow-hidden rounded-[2rem] bg-navy-950 p-10 text-center shadow-2xl sm:p-14">
          <h2 class="font-display text-2xl font-extrabold text-white sm:text-3xl">Ενδιαφέρεστε για Inverter;</h2>
          <p class="mx-auto mt-3 max-w-xl text-white/65">
            Επικοινωνήστε μαζί μας για τεχνικές πληροφορίες, διαθεσιμότητα και προσφορά τιμής.
          </p>
          <div class="mt-8 flex flex-wrap justify-center gap-4">
            <a href={withBase("#contact")} class="btn btn-primary">Ζητήστε Προσφορά</a>
            <a href="tel:+306976724504" class="btn btn-ghost">Καλέστε μας</a>
          </div>
        </div>
      </div>
    </section>

  </main>
  <Footer />
  <BackToTop />
</BaseLayout>
