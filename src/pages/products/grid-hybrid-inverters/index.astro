---
import { Image } from "astro:assets";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import BackToTop from "../../../components/BackToTop.astro";
import { withBase } from "../../../lib/paths";
import goodweP1 from "../../../assets/products/lv-goodwe-p1.jpg";
import goodweP2 from "../../../assets/products/lv-goodwe-p2.jpg";
import goodweP3 from "../../../assets/products/lv-goodwe-p3.jpg";
import goodweP4 from "../../../assets/products/lv-goodwe-p4.jpg";
import goodweP5 from "../../../assets/products/lv-goodwe-p5.jpg";
import goodweP6 from "../../../assets/products/lv-goodwe-p6.jpg";

const title = "Inverters | Alphatech Energy";
const description = "Grid & Hybrid Inverters από κορυφαίους κατασκευαστές για κάθε τύπο φωτοβολταϊκού έργου.";
---

<BaseLayout title={title} description={description} path="/products/grid-hybrid-inverters/">
  <Header />
  <main class="pt-24">

    {/* ── Breadcrumb ── */}
    <div class="border-b border-navy-900/8 bg-white">
      <div class="container-page py-4">
        <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-2 text-sm text-navy-900/50">
          <a href={withBase("")} class="hover:text-azure-600">Αρχική</a>
          <span aria-hidden="true">/</span>
          <a href={withBase("products/")} class="hover:text-azure-600">Προϊόντα</a>
          <span aria-hidden="true">/</span>
          <span class="font-medium text-navy-900">Inverters</span>
        </nav>
      </div>
    </div>

    {/* ── Hero ── */}
    <section class="bg-gradient-to-b from-white to-ice-100/40 py-16 sm:py-20">
      <div class="container-page grid gap-12 lg:grid-cols-2 lg:items-center">
        <div class="overflow-hidden rounded-[2rem] border border-navy-900/8 bg-white shadow-card" data-reveal>
          <Image src={goodweP1} alt="GoodWe Hybrid Inverter SG-EH3P50K-H" width={1225} height={1650} class="h-auto w-full object-cover" />
        </div>

        <div data-reveal>
          <p class="text-xs font-bold tracking-[0.14em] text-azure-600 uppercase">Grid &amp; Hybrid Inverters</p>
          <h1 class="mt-3 font-display text-3xl font-extrabold tracking-tight text-navy-900 sm:text-4xl xl:text-5xl 2xl:text-6xl">
            Inverters
          </h1>
          <p class="mt-5 text-lg leading-relaxed text-navy-900/60">
            Αξιόπιστοι μετατροπείς ισχύος από κορυφαίους κατασκευαστές, για κάθε τύπο φωτοβολταϊκού έργου. Οικιακά, εμπορικά και βιομηχανικά συστήματα.
          </p>

          <ul class="mt-6 space-y-2.5">
            {[
              "On-grid, off-grid και hybrid λύσεις",
              "Τριφασικοί inverters υψηλής ισχύος",
              "Ενσωματωμένο BMS & έξυπνη διαχείριση ενέργειας",
              "Παρακολούθηση μέσω WiFi, Bluetooth & RS485",
              "Υψηλή απόδοση έως 97.8%",
              "Τεχνική υποστήριξη & εγγύηση",
            ].map((f) => (
              <li class="flex items-start gap-2.5 text-sm font-medium text-navy-900/75">
                <svg class="mt-0.5 h-4 w-4 shrink-0 text-azure-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                </svg>
                {f}
              </li>
            ))}
          </ul>

          <div class="mt-8 flex flex-wrap gap-4">
            <a href={withBase("#contact")} class="btn btn-primary">Ζητήστε Προσφορά</a>
            <a href="#datasheets" class="inline-flex items-center gap-2 rounded-xl border border-azure-200 bg-azure-50 px-5 py-3 text-sm font-semibold text-azure-700 shadow-sm transition hover:bg-azure-100 hover:-translate-y-0.5">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
              Δείτε τα Datasheets
            </a>
          </div>
        </div>
      </div>
    </section>

    {/* ── Datasheet Gallery ── */}
    <section id="datasheets" class="bg-ice-50/60 py-16 sm:py-20">
      <div class="container-page">
        <div class="mx-auto max-w-2xl text-center mb-10" data-reveal>
          <span class="eyebrow border-azure-500/20 text-azure-600">Τεχνικά Φυλλάδια</span>
          <h2 class="mt-4 font-display text-2xl font-extrabold tracking-tight text-navy-900 sm:text-3xl">Datasheets</h2>
        </div>

        <div class="mb-10" data-reveal>
          <p class="mb-4 text-xs font-bold tracking-[0.14em] text-azure-600 uppercase">GoodWe ET 25–50 kW — SG-EH3P50K-H</p>
          <div class="grid gap-4 sm:grid-cols-2">
            {[goodweP1, goodweP2, goodweP3, goodweP4, goodweP5, goodweP6].map((img, i) => (
              <a href={withBase("downloads/LV-GoodWe-ET-25-50kW-Datasheet.pdf")} target="_blank" rel="noopener"
                 class="group overflow-hidden rounded-2xl border border-navy-900/8 bg-white shadow-sm transition hover:shadow-md">
                <Image src={img} alt={`GoodWe ET Datasheet σελίδα ${i + 1}`} width={1225} height={1650}
                       class="w-full h-auto transition-transform duration-300 group-hover:scale-[1.02]" />
              </a>
            ))}
          </div>
        </div>

        <div class="text-center" data-reveal>
          <a href={withBase("downloads/LV-GoodWe-ET-25-50kW-Datasheet.pdf")} target="_blank" rel="noopener"
             class="inline-flex items-center gap-2 rounded-xl border border-navy-900/10 bg-white px-5 py-3 text-sm font-semibold text-navy-900 shadow-sm transition hover:shadow-md hover:-translate-y-0.5">
            <svg class="h-4 w-4 text-azure-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/><line x1="9" y1="15" x2="15" y2="15"/>
            </svg>
            GoodWe ET 25–50 kW — Datasheet PDF
          </a>
        </div>
      </div>
    </section>

    {/* ── CTA ── */}
    <section class="bg-white py-16 sm:py-20">
      <div class="container-page">
        <div class="overflow-hidden rounded-[2rem] bg-navy-950 p-10 text-center shadow-2xl sm:p-14">
          <h2 class="font-display text-2xl font-extrabold text-white sm:text-3xl">Ενδιαφέρεστε για Inverter;</h2>
          <p class="mx-auto mt-3 max-w-xl text-white/65">
            Επικοινωνήστε μαζί μας για τεχνικές πληροφορίες, διαθεσιμότητα και προσφορά τιμής.
          </p>
          <div class="mt-8 flex flex-wrap justify-center gap-4">
            <a href={withBase("#contact")} class="btn btn-primary">Ζητήστε Προσφορά</a>
            <a href="tel:+306976724504" class="btn btn-ghost">Καλέστε μας</a>
          </div>
        </div>
      </div>
    </section>

  </main>
  <Footer />
  <BackToTop />
</BaseLayout>
