---
import { Image } from "astro:assets";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import BackToTop from "../../../components/BackToTop.astro";
import { withBase } from "../../../lib/paths";
import heroImg from "../../../assets/hero/projoy-pefs-combiner.jpg";

const title = "Projoy PEFS Series — Rapid Shutdown PV | Alphatech Energy";
const description =
  "Projoy PEFS-PL Series Module-level Rapid Shutdown συστήματα ασφαλείας για φωτοβολταϊκές εγκαταστάσεις. Συμμόρφωση NEC 2017/2020, UL1741 & UL3741. Επίσημος διανομέας.";

const moduleModels = [
  {
    model: "PEFS-PL80S-1I",
    maxInputVoltage: "80V",
    maxOutputVoltage: "80V",
    rsdRatio: "1:1",
    maxInputCurrent: "20A",
    maxOutputCurrent: "20A",
    powerConsumption: "0.6W–0.8W",
  },
  {
    model: "PEFS-PL80S-2I",
    maxInputVoltage: "80V",
    maxOutputVoltage: "160V",
    rsdRatio: "1:2",
    maxInputCurrent: "20A",
    maxOutputCurrent: "20A",
    powerConsumption: "1.2W–1.6W",
  },
  {
    model: "PEFS-PL120S-1I",
    maxInputVoltage: "120V",
    maxOutputVoltage: "120V",
    rsdRatio: "1:2",
    maxInputCurrent: "20A",
    maxOutputCurrent: "20A",
    powerConsumption: "0.6W–0.8W",
  },
  {
    model: "PEFS-PL120S-2I",
    maxInputVoltage: "120V",
    maxOutputVoltage: "240V",
    rsdRatio: "1:4",
    maxInputCurrent: "20A",
    maxOutputCurrent: "20A",
    powerConsumption: "1.2W–1.6W",
  },
];

const controlBoxModels = [
  {
    model: "PEFS-PCY / PCZS-S-60-1I",
    acVoltageRange: "100V–240V",
    outputVoltage: "24V DC",
    outputCurrent: "2.2A",
  },
  {
    model: "PEFS-PCY / PCZS-S-180-3I",
    acVoltageRange: "180V–264V",
    outputVoltage: "24V DC",
    outputCurrent: "8.8A (3 Channels)",
  },
  {
    model: "PEFS-PCY / PCZS-S-480-8I",
    acVoltageRange: "180V–264V",
    outputVoltage: "24V DC",
    outputCurrent: "17.6A (8 Channels)",
  },
];
---

<BaseLayout title={title} description={description} path="/products/projoy-pefs-rapid-shutdown/">
  <Header />
  <main class="pt-24">

    {/* ── Breadcrumb ── */}
    <div class="border-b border-navy-900/8 bg-white">
      <div class="container-page py-4">
        <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-2 text-sm text-navy-900/50">
          <a href={withBase("")} class="hover:text-azure-600">Αρχική</a>
          <span aria-hidden="true">/</span>
          <a href={withBase("products/")} class="hover:text-azure-600">Προϊόντα</a>
          <span aria-hidden="true">/</span>
          <span class="font-medium text-navy-900">Projoy PEFS Rapid Shutdown</span>
        </nav>
      </div>
    </div>

    {/* ── Hero ── */}
    <section class="bg-gradient-to-b from-white to-ice-100/40 py-16 sm:py-20">
      <div class="container-page grid gap-12 lg:grid-cols-2 lg:items-center">
        <div class="flex items-center justify-center overflow-hidden rounded-[2rem] border border-navy-900/8 bg-white shadow-card" data-reveal>
          <Image
            src={heroImg}
            alt="Projoy PEFS Series PV Combiner & Rapid Shutdown"
            width={700}
            height={520}
            class="h-auto w-full object-cover"
          />
        </div>

        <div data-reveal>
          <p class="text-xs font-bold tracking-[0.14em] text-azure-600 uppercase">Projoy Electric · PV Safety</p>
          <h1 class="mt-3 font-display text-3xl font-extrabold tracking-tight text-navy-900 sm:text-4xl">
            PEFS Series — Rapid Shutdown
          </h1>
          <p class="mt-2 text-base font-medium text-navy-900/50">PV Combiner Box · Module-Level Safety</p>
          <p class="mt-4 text-base leading-relaxed text-navy-900/60">
            Το PROJOY PEFS-PL Series Module-level Rapid Shutdown είναι αξιόπιστη συσκευή ασφαλείας σύμφωνα με τα πρότυπα NEC 2017/2020 690.12, UL1741 &amp; UL3741 για φωτοβολταϊκά συστήματα σε στέγες. Εξασφαλίζει χαμηλό κόστος BOS, διπλό επίπεδο ασφαλείας και πλήρη προστασία ανθρώπων και εξοπλισμού.
          </p>

          <div class="mt-6 flex flex-wrap gap-2">
            {["NEC 2017/2020", "UL1741", "UL3741", "CE", "IP68 / NEMA 4X", "UL94-V0"].map((cert) => (
              <span class="rounded-full border border-azure-200 bg-azure-50 px-3 py-1 text-xs font-bold text-azure-700">
                {cert}
              </span>
            ))}
          </div>
        </div>
      </div>
    </section>

    {/* ── Module Features ── */}
    <section class="bg-white py-16 sm:py-20">
      <div class="container-page">
        <div class="mx-auto max-w-2xl text-center" data-reveal>
          <span class="eyebrow">Rapid Shutdown — Module Level</span>
          <h2 class="mt-4 font-display text-2xl font-extrabold tracking-tight text-navy-900 sm:text-3xl">
            Χαρακτηριστικά Προϊόντος
          </h2>
        </div>

        <div class="mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-3" data-reveal>
          {[
            "Συμβατό με inverters όλων των κατασκευαστών",
            "Max. είσοδος: 20A, 80V/120V — κατάλληλο για mainstream PV panels",
            "Χωρίς cross-talking — απλούστερη καλωδίωση στο εργοτάξιο",
            "Flame retardant UL94-V0",
            "Μοναδική τεχνολογία αισθητήρα θερμοκρασίας — αυτόματο shutdown στους 85°C",
            "Slim design — εύκολη εγκατάσταση",
            "Ανεξάρτητος έλεγχος γραμμής — χωρίς παρεμβολές",
            "25 χρόνια διάρκεια ζωής · 12 χρόνια εγγύηση",
            "Πιστοποιήσεις: CE, UL 1741 & UL 3741",
          ].map((f) => (
            <div class="flex items-start gap-3 rounded-xl border border-navy-900/6 bg-ice-50 px-4 py-3">
              <svg class="mt-0.5 h-4 w-4 shrink-0 text-azure-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
              </svg>
              <span class="text-sm text-navy-900/70">{f}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* ── Module Craftsmanship ── */}
    <section class="bg-ice-50/60 py-16 sm:py-20">
      <div class="container-page">
        <div class="mx-auto max-w-2xl text-center" data-reveal>
          <h2 class="font-display text-2xl font-extrabold tracking-tight text-navy-900 sm:text-3xl">
            High Craftsmanship &amp; Standards
          </h2>
          <p class="mt-2 text-sm text-navy-900/50">PEFS-PL Series</p>
        </div>

        <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4" data-reveal>
          {[
            { icon: "🌡️", title: "Προστασία υπερθέρμανσης", desc: "≥ 85°C αυτόματο shutdown" },
            { icon: "⚡", title: "Max 20A", desc: "Υψηλή ρευματοφόρος ικανότητα" },
            { icon: "🔥", title: "Flame retardant", desc: "UL94-V0 πιστοποίηση" },
            { icon: "🛡️", title: "Ingress protection", desc: "≥ IP68 / NEMA 4X" },
            { icon: "📡", title: "Anti-interference", desc: "Υψηλή αξιοπιστία & σταθερότητα" },
            { icon: "⏳", title: "25 χρόνια διάρκεια ζωής", desc: "Μακρόχρονη απόδοση" },
            { icon: "🔌", title: "Universal compatibility", desc: "Slim EMC Design, εύκολη εγκατάσταση" },
            { icon: "☀️", title: "Diad & Triad PV modules", desc: "Πλήρης συμβατότητα" },
          ].map((item) => (
            <div class="rounded-2xl border border-navy-900/6 bg-white p-5 text-center shadow-sm">
              <div class="mb-3 text-3xl">{item.icon}</div>
              <p class="text-sm font-bold text-navy-900">{item.title}</p>
              <p class="mt-1 text-xs text-navy-900/55">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* ── Module Technical Table ── */}
    <section class="bg-white py-16 sm:py-20">
      <div class="container-page">
        <div class="mx-auto max-w-2xl text-center" data-reveal>
          <span class="eyebrow">Module-Level RSD</span>
          <h2 class="mt-4 font-display text-2xl font-extrabold tracking-tight text-navy-900 sm:text-3xl">
            Τεχνικά Χαρακτηριστικά
          </h2>
          <p class="mt-2 text-sm text-navy-900/50">PEFS-PL Series — Product Models</p>
        </div>

        <div class="mt-10 overflow-x-auto rounded-2xl border border-navy-900/8 shadow-sm" data-reveal>
          <table class="w-full min-w-[600px] text-sm">
            <thead>
              <tr class="bg-navy-900 text-white">
                <th class="px-4 py-3 text-left font-semibold">Παράμετρος</th>
                {moduleModels.map((m) => (
                  <th class="px-4 py-3 text-center font-semibold">{m.model}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {[
                { label: "Max Input Voltage", key: "maxInputVoltage" },
                { label: "Max Output Voltage", key: "maxOutputVoltage" },
                { label: "RSD : Module(s)", key: "rsdRatio" },
                { label: "Max Input Current", key: "maxInputCurrent" },
                { label: "Max Output Current", key: "maxOutputCurrent" },
                { label: "Power Consumption", key: "powerConsumption" },
              ].map((row, ri) => (
                <tr class={ri % 2 === 0 ? "bg-white" : "bg-ice-50/60"}>
                  <td class="px-4 py-3 font-medium text-navy-900/80">{row.label}</td>
                  {moduleModels.map((m) => (
                    <td class="px-4 py-3 text-center text-navy-900/65">{(m as any)[row.key]}</td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    {/* ── Control Box ── */}
    <section class="bg-navy-950 py-16 sm:py-20">
      <div class="container-page">
        <div class="mx-auto max-w-2xl text-center" data-reveal>
          <span class="eyebrow border-white/25 bg-white/10 text-azure-200 backdrop-blur-sm">Εξαρτήματα Συστήματος</span>
          <h2 class="mt-4 font-display text-2xl font-extrabold tracking-tight text-white sm:text-3xl">
            Rapid Shutdown Control Box
          </h2>
          <p class="mt-2 text-sm text-white/50">DC 24V — PEFS-PCY / PCZS Series</p>
        </div>

        {/* Control Box Standards */}
        <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4" data-reveal>
          {[
            { icon: "📋", title: "NEC2017 / NEC2020", desc: "Συμμόρφωση 690.12 & Sunspec RSD" },
            { icon: "🔥", title: "UL94-V0", desc: "Flame retardant υλικό" },
            { icon: "🔒", title: "Lockable", desc: "Αποτροπή τυχαίας ενεργοποίησης" },
            { icon: "✅", title: "UL 1741 / UL 3741", desc: "PVRSE & PVRSS compliance" },
            { icon: "☀️", title: "Έως 480 modules", desc: "Κεντρικός έλεγχος ολόκληρης εγκατάστασης" },
            { icon: "🛡️", title: "IP65", desc: "Αδιάβροχη προστασία" },
            { icon: "🌡️", title: "Max 50°C", desc: "Μηδενική υποβάθμιση απόδοσης" },
            { icon: "📡", title: "Anti-interference", desc: "Σταθερή & αξιόπιστη λειτουργία" },
          ].map((item) => (
            <div class="rounded-xl border border-white/8 bg-white/5 p-4 text-center">
              <div class="mb-2 text-2xl">{item.icon}</div>
              <p class="text-sm font-bold text-white">{item.title}</p>
              <p class="mt-1 text-xs text-white/50">{item.desc}</p>
            </div>
          ))}
        </div>

        {/* Control Box Table */}
        <div class="mt-12 overflow-x-auto rounded-2xl border border-white/10 shadow-lg" data-reveal>
          <table class="w-full min-w-[560px] text-sm">
            <thead>
              <tr class="bg-white/10 text-white">
                <th class="px-4 py-3 text-left font-semibold">Παράμετρος</th>
                {controlBoxModels.map((m) => (
                  <th class="px-4 py-3 text-center font-semibold text-xs">{m.model}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {[
                { label: "AC Voltage Range", key: "acVoltageRange" },
                { label: "Output Voltage", key: "outputVoltage" },
                { label: "Output Current", key: "outputCurrent" },
              ].map((row, ri) => (
                <tr class={ri % 2 === 0 ? "bg-white/5" : "bg-white/[0.02]"}>
                  <td class="px-4 py-3 font-medium text-white/70">{row.label}</td>
                  {controlBoxModels.map((m) => (
                    <td class="px-4 py-3 text-center text-white/55">{(m as any)[row.key]}</td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    {/* ── Contact ── */}
    <section class="bg-white py-16 sm:py-20">
      <div class="container-page text-center" data-reveal>
        <h2 class="font-display text-2xl font-extrabold tracking-tight text-navy-900 sm:text-3xl">
          Ζητήστε Προσφορά
        </h2>
        <p class="mx-auto mt-4 max-w-lg text-base leading-relaxed text-navy-900/60">
          Επικοινωνήστε μαζί μας για τιμές, διαθεσιμότητα και τεχνική υποστήριξη στα συστήματα Projoy PEFS.
        </p>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
          <a href="tel:+306976724504" class="btn btn-primary">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.51 2 2 0 0 1 3.6 1.34h3a2 2 0 0 1 2 1.72c.12.96.36 1.9.71 2.81a2 2 0 0 1-.45 2.11L7.91 9a16 16 0 0 0 6 6l.86-.86a2 2 0 0 1 2.11-.45c.91.35 1.85.6 2.81.71A2 2 0 0 1 21.61 16.92z"/>
            </svg>
            +30 697 672 4504
          </a>
          <a href={withBase("products/")} class="btn btn-outline">Όλα τα Προϊόντα</a>
        </div>
      </div>
    </section>

  </main>
  <Footer />
  <BackToTop />
</BaseLayout>
