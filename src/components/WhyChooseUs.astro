---

<section id="why-us" class="relative bg-white py-24 sm:py-32 xl:py-40 2xl:py-48">
  <div class="container-page">
    <div class="mx-auto max-w-2xl text-center xl:max-w-3xl" data-reveal>
      <span class="eyebrow border-azure-500/20 text-azure-600" data-i18n="why.eyebrow">Γιατί να μας Επιλέξετε</span>
      <h2 class="mt-5 font-display text-3xl font-extrabold tracking-tight text-navy-900 sm:text-4xl xl:text-5xl 2xl:text-6xl" data-i18n="why.h2">
        Ένας Αξιόπιστος Συνεργάτης
      </h2>
      <p class="mt-4 text-lg text-navy-900/60 xl:text-xl 2xl:text-2xl" data-i18n="why.desc">
        Αξιοπιστία και ποιότητα — η υπόσχεσή μας σε κάθε έργο.
      </p>
    </div>

    <div class="mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:gap-8 2xl:gap-10">
      {
        features.map((f, i) => (
          <div
            class="group relative overflow-hidden rounded-3xl border border-navy-900/8 bg-white p-8 shadow-card transition-all duration-300 hover:-translate-y-1 hover:border-azure-400/30 hover:shadow-[0_24px_48px_-16px_rgba(47,127,224,0.25)] xl:p-10 2xl:p-12"
            data-reveal
            style={`transition-delay:${i * 60}ms`}
          >
            <div class="absolute -top-8 -right-8 h-24 w-24 rounded-full bg-azure-500/5 transition-transform duration-500 group-hover:scale-150" />
            <div class="relative flex h-12 w-12 items-center justify-center rounded-2xl bg-gradient-to-br from-azure-500 to-navy-700 text-white shadow-glow xl:h-14 xl:w-14 2xl:h-16 2xl:w-16">
              <svg class="h-6 w-6 xl:h-7 xl:w-7 2xl:h-8 2xl:w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d={f.icon} />
              </svg>
            </div>
            <h3 class="relative mt-6 font-display text-lg font-bold text-navy-900 xl:text-xl 2xl:text-2xl" data-i18n={`${f.key}.title`}>{f.title}</h3>
            <p class="relative mt-3 text-sm leading-relaxed text-navy-900/60 xl:text-base 2xl:text-lg" data-i18n={`${f.key}.desc`}>{f.desc}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
