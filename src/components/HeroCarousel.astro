---
import { Image } from "astro:assets";
import { withBase } from "../lib/paths";
import powertrunk from "../assets/hero/tsun-powertrunk.jpg";
import hyperIonPro from "../assets/hero/risen-hyper-ion-pro.jpg";
import risenCiStorage from "../assets/hero/risen-ci-storage.jpg";
import lvBattery from "../assets/hero/hero-img3463.jpg";
import lvHomeStorage from "../assets/hero/hero-img3464.jpg";

const slides = [
  { image: powertrunk, alt: "TSUN PowerTrunk", width: 1284, height: 2228, href: withBase("products/hybrid-microinverter-2000w/"), scale: 1 },
  { image: hyperIonPro, alt: "Risen Hyper-ion Pro Solar Panel", width: 896, height: 1200, href: null, scale: 1 },
  { image: risenCiStorage, alt: "Risen C&I Energy Storage System", width: 896, height: 1200, href: withBase("products/risen-ci-energy-storage/"), scale: 1 },
  { image: lvBattery, alt: "LithiumValley 12V 100Ah Pro Rechargeable Li-ion Battery", width: 896, height: 1200, href: null, scale: 0.72 },
  { image: lvHomeStorage, alt: "LithiumValley Home Energy Storage System with Solar and EV Charging", width: 896, height: 1200, href: null, scale: 0.72 },
];
---

<div class="relative h-full w-full touch-pan-y overflow-hidden bg-navy-950 select-none" data-hero-carousel>
  {
    slides.map((s, i) => (
      <div
        class={`absolute inset-0 transition-all duration-700 ease-out${s.href ? " cursor-pointer" : ""}`}
        data-slide
        data-href={s.href ?? ""}
        style={`transform:translateX(${i === 0 ? "0" : "100%"});opacity:${i === 0 ? "1" : "0"}`}
      >
        <Image
          src={s.image}
          alt={s.alt}
          width={s.width}
          height={s.height}
          loading={i === 0 ? "eager" : "lazy"}
          draggable={false}
          class="h-full w-full object-contain [-webkit-user-drag:none] transition-transform duration-700"
          style={s.scale !== 1 ? `transform: scale(${s.scale})` : undefined}
        />
      </div>
    ))
  }

  <div class="absolute inset-x-0 bottom-6 z-20 flex justify-center gap-2">
    {
      slides.map((_, i) => (
        <button
          type="button"
          class="h-2 w-2 rounded-full bg-white/60 shadow transition-all duration-300 data-[active=true]:w-7 data-[active=true]:bg-white"
          data-dot={i}
          data-active={i === 0}
          aria-label={`Προβολή διαφάνειας ${i + 1}`}
        />
      ))
    }
  </div>
</div>

<script>
  const roots = document.querySelectorAll<HTMLElement>("[data-hero-carousel]:not([data-carousel-init])");

  roots.forEach((root) => {
    root.setAttribute("data-carousel-init", "true");
    const slideEls = Array.from(root.querySelectorAll<HTMLElement>("[data-slide]"));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-dot]"));
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let current = 0;
    let timer: ReturnType<typeof setInterval> | null = null;

    const render = () => {
      slideEls.forEach((el, i) => {
        const offset = i === current ? "0" : i < current ? "-100%" : "100%";
        el.style.transform = `translateX(${offset})`;
        el.style.opacity = i === current ? "1" : "0";
      });
      dots.forEach((dot, i) => dot.setAttribute("data-active", String(i === current)));
    };

    const goTo = (index: number) => {
      current = (index + slideEls.length) % slideEls.length;
      render();
    };

    const start = () => {
      if (reduceMotion || timer) return;
      timer = setInterval(() => goTo(current + 1), 4500);
    };
    const stop = () => {
      if (timer) {
        clearInterval(timer);
        timer = null;
      }
    };

    dots.forEach((dot, i) =>
      dot.addEventListener("click", () => {
        goTo(i);
        stop();
        start();
      })
    );

    root.addEventListener("mouseenter", stop);
    root.addEventListener("mouseleave", start);

    let dragStartX: number | null = null;
    let dragStartY: number | null = null;
    let dragging = false;
    const SWIPE_THRESHOLD = 40;

    root.addEventListener("pointerdown", (e) => {
      dragStartX = e.clientX;
      dragStartY = e.clientY;
      dragging = true;
      stop();
      e.preventDefault();
    });

    root.addEventListener("pointerup", (e) => {
      if (!dragging || dragStartX === null || dragStartY === null) return;
      const deltaX = e.clientX - dragStartX;
      const deltaY = e.clientY - dragStartY;
      dragging = false;
      dragStartX = null;
      dragStartY = null;
      if (Math.abs(deltaX) > SWIPE_THRESHOLD && Math.abs(deltaX) > Math.abs(deltaY)) {
        goTo(current + (deltaX < 0 ? 1 : -1));
      } else {
        const href = slideEls[current]?.getAttribute("data-href");
        if (href) window.location.href = href;
      }
      start();
    });

    root.addEventListener("pointercancel", () => {
      dragging = false;
      dragStartX = null;
      dragStartY = null;
      start();
    });

    render();
    start();
  });
</script>
