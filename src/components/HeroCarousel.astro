---
import { Image } from "astro:assets";
import topconPanels from "../assets/hero/risen-topcon-panels.jpg";
import hjtPanels from "../assets/hero/risen-hjt-panels.jpg";
import batteryStorage from "../assets/hero/risen-battery-storage.jpg";
import microinverters from "../assets/hero/hybrid-microinverter.jpg";

const slides = [
  { image: topconPanels, tag: "TOPCON PANELS", title: "Topcon Πάνελ", width: 1600, height: 985 },
  { image: hjtPanels, tag: "HETEROJUNCTION", title: "HJT Πάνελ", width: 1600, height: 1034 },
  { image: batteryStorage, tag: "ENERGY STORAGE", title: "Μπαταρίες Αποθήκευσης", width: 1600, height: 810 },
  { image: microinverters, tag: "MICROINVERTERS", title: "Υβριδικά Microinverters", width: 1700, height: 1060 },
];
---

<div class="absolute inset-0 touch-pan-y overflow-hidden bg-navy-950 select-none" data-hero-carousel>
  {
    slides.map((s, i) => (
      <div
        class="absolute inset-0 transition-all duration-700 ease-out"
        data-slide
        style={`transform:translateX(${i === 0 ? "0" : "100%"});opacity:${i === 0 ? "1" : "0"}`}
      >
        <Image
          src={s.image}
          alt={s.title}
          width={s.width}
          height={s.height}
          loading={i === 0 ? "eager" : "lazy"}
          draggable={false}
          class="h-full w-full object-contain object-top p-4 pt-24 sm:p-8 sm:pt-24 lg:object-cover lg:p-0 [-webkit-user-drag:none]"
        />
        <div class="absolute top-24 left-4 sm:left-6 lg:top-28">
          <p class="text-[11px] font-bold tracking-[0.14em] text-azure-300 uppercase drop-shadow-[0_1px_4px_rgba(0,0,0,0.9)]">{s.tag}</p>
          <p class="mt-0.5 font-display text-lg font-bold text-white drop-shadow-[0_1px_4px_rgba(0,0,0,0.9)]">{s.title}</p>
        </div>
      </div>
    ))
  }

  <div class="absolute inset-0 bg-navy-950/25 lg:bg-navy-950/40"></div>
  <div class="absolute inset-x-0 bottom-0 h-3/5 bg-gradient-to-t from-navy-950 via-navy-950/70 to-transparent"></div>

  <div class="absolute inset-x-0 bottom-5 z-20 flex justify-center gap-2">
    {
      slides.map((_, i) => (
        <button
          type="button"
          class="h-1.5 w-1.5 rounded-full bg-white/50 transition-all duration-300 data-[active=true]:w-6 data-[active=true]:bg-white"
          data-dot={i}
          data-active={i === 0}
          aria-label={`Προβολή διαφάνειας ${i + 1}`}
        />
      ))
    }
  </div>
</div>

<script>
  const roots = document.querySelectorAll<HTMLElement>("[data-hero-carousel]");

  roots.forEach((root) => {
    const slideEls = Array.from(root.querySelectorAll<HTMLElement>("[data-slide]"));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-dot]"));
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let current = 0;
    let timer: ReturnType<typeof setInterval> | null = null;

    const render = () => {
      slideEls.forEach((el, i) => {
        const offset = i === current ? "0" : i < current ? "-100%" : "100%";
        el.style.transform = `translateX(${offset})`;
        el.style.opacity = i === current ? "1" : "0";
      });
      dots.forEach((dot, i) => dot.setAttribute("data-active", String(i === current)));
    };

    const goTo = (index: number) => {
      current = (index + slideEls.length) % slideEls.length;
      render();
    };

    const start = () => {
      if (reduceMotion || timer) return;
      timer = setInterval(() => goTo(current + 1), 4500);
    };
    const stop = () => {
      if (timer) {
        clearInterval(timer);
        timer = null;
      }
    };

    dots.forEach((dot, i) =>
      dot.addEventListener("click", () => {
        goTo(i);
        stop();
        start();
      })
    );

    root.addEventListener("mouseenter", stop);
    root.addEventListener("mouseleave", start);

    // Swipe / drag navigation (touch and mouse via the Pointer Events API).
    let dragStartX: number | null = null;
    let dragStartY: number | null = null;
    let dragging = false;
    const SWIPE_THRESHOLD = 40;

    root.addEventListener("pointerdown", (e) => {
      dragStartX = e.clientX;
      dragStartY = e.clientY;
      dragging = true;
      stop();
      e.preventDefault();
    });

    root.addEventListener("pointerup", (e) => {
      if (!dragging || dragStartX === null || dragStartY === null) return;
      const deltaX = e.clientX - dragStartX;
      const deltaY = e.clientY - dragStartY;
      dragging = false;
      dragStartX = null;
      dragStartY = null;
      // Ignore mostly-vertical drags so page scrolling on touch isn't hijacked.
      if (Math.abs(deltaX) > SWIPE_THRESHOLD && Math.abs(deltaX) > Math.abs(deltaY)) {
        goTo(current + (deltaX < 0 ? 1 : -1));
      }
      start();
    });

    root.addEventListener("pointercancel", () => {
      dragging = false;
      dragStartX = null;
      dragStartY = null;
      start();
    });

    render();
    start();
  });
</script>
