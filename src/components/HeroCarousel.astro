---
import { Image } from "astro:assets";
import solartrunkTrio from "../assets/hero/tsun-solartrunk-trio.jpg";
import powertrunkSolo from "../assets/hero/tsun-powertrunk-solo.jpg";
import microinverters from "../assets/hero/tsun-microinverters.jpg";
import solarPanels from "../assets/hero/tsun-solar-panels.jpg";
import lineup from "../assets/hero/tsun-lineup.jpg";
import easySolarKit from "../assets/hero/tsun-easy-solar-kit.jpg";
import microinverter60v from "../assets/hero/tsun-microinverter-60v.jpg";
import storageWall from "../assets/hero/tsun-storage-wall.jpg";

const slides = [
  {
    image: solartrunkTrio,
    alt: "TSUN SolarTrunk MSU4000Elite",
    width: 896,
    height: 1200,
    label: "Αποθήκευση Ενέργειας",
    title: "SolarTrunk MSU4000Elite",
    subtitle: "Micro Hybrid Storage Unit · Plug & Play · EV Ready",
  },
  {
    image: powertrunkSolo,
    alt: "TSUN PowerTrunk MAU 5000",
    width: 896,
    height: 1200,
    label: "Αποθήκευση Ενέργειας",
    title: "PowerTrunk MAU 5000",
    subtitle: "All-in-One Energy Storage Solution",
  },
  {
    image: microinverters,
    alt: "TSUN Microinverters",
    width: 896,
    height: 1200,
    label: "Μικροαντιστροφείς",
    title: "No.1 Powerful Microinverter",
    subtitle: "Make Safety Affordable",
  },
  {
    image: solarPanels,
    alt: "TSUN Solar Panels",
    width: 896,
    height: 1200,
    label: "Φωτοβολταϊκά Πάνελ",
    title: "TSUN Solar Panels",
    subtitle: "High Efficiency · Premium Performance",
  },
  {
    image: lineup,
    alt: "TSUN Full Product Lineup",
    width: 896,
    height: 1200,
    label: "Πλήρης Σειρά Προϊόντων",
    title: "Ολοκληρωμένες Λύσεις",
    subtitle: "Microinverters · Storage Systems · Solar Panels",
  },
  {
    image: easySolarKit,
    alt: "TSUN Easy Solar Kit - Balcony Installation",
    width: 1284,
    height: 1712,
    label: "Εύκολη Εγκατάσταση",
    title: "Easy Solar Kit",
    subtitle: "Μπαλκόνι · Κήπος · Τοίχος · Plug & Play",
  },
  {
    image: microinverter60v,
    alt: "TSUN Microinverter 60V Max DC Voltage",
    width: 1284,
    height: 1712,
    label: "Ασφάλεια & Απόδοση",
    title: "60V Max. DC Voltage",
    subtitle: "No Risk of Fire · NEC2020 Compliant · Safe by Design",
  },
  {
    image: storageWall,
    alt: "TSUN Hybrid Storage System Wall Installation",
    width: 1284,
    height: 1712,
    label: "Αποθήκευση Ενέργειας",
    title: "Hybrid Microinverter System",
    subtitle: "Grid-Tied · Off-Grid · Stackable Battery Pack",
  },
];
---

<div class="relative h-full w-full touch-pan-y overflow-hidden bg-navy-950 select-none" data-hero-carousel>
  {
    slides.map((s, i) => (
      <div
        class="absolute inset-0 transition-all duration-700 ease-out"
        data-slide
        style={`transform:translateX(${i === 0 ? "0" : "100%"});opacity:${i === 0 ? "1" : "0"}`}
      >
        <Image
          src={s.image}
          alt={s.alt}
          width={s.width}
          height={s.height}
          loading={i === 0 ? "eager" : "lazy"}
          draggable={false}
          class="h-full w-full object-cover object-center [-webkit-user-drag:none]"
        />

        {/* Bottom gradient for text readability */}
        <div class="pointer-events-none absolute inset-x-0 bottom-0 h-72 bg-gradient-to-t from-black/75 via-black/30 to-transparent" />

        {/* Product details */}
        <div class="slide-text absolute inset-x-0 bottom-14 z-10 px-6 sm:px-10">
          <span class="hero-slide-label block text-[11px] font-bold tracking-[0.2em] uppercase text-azure-300 mb-2">
            {s.label}
          </span>
          <h2 class="hero-slide-title text-[1.6rem] sm:text-3xl lg:text-4xl font-extrabold text-white leading-tight">
            {s.title}
          </h2>
          <p class="hero-slide-subtitle mt-1.5 text-sm sm:text-base text-white/70 font-medium">
            {s.subtitle}
          </p>
        </div>
      </div>
    ))
  }

  <div class="absolute inset-x-0 bottom-4 z-20 flex justify-center gap-2">
    {
      slides.map((_, i) => (
        <button
          type="button"
          class="h-2 w-2 rounded-full bg-white/60 shadow transition-all duration-300 data-[active=true]:w-7 data-[active=true]:bg-white"
          data-dot={i}
          data-active={i === 0}
          aria-label={`Προβολή διαφάνειας ${i + 1}`}
        />
      ))
    }
  </div>
</div>

<style is:global>
  /* ── Ken Burns: slow zoom while slide is active ── */
  @keyframes hero-ken-burns {
    from { transform: scale(1) translateZ(0); }
    to   { transform: scale(1.09) translateZ(0); }
  }

  [data-slide][data-active="true"] img {
    animation: hero-ken-burns 5.5s ease-out forwards;
    will-change: transform;
  }
  [data-slide]:not([data-active="true"]) img {
    animation: none;
    transform: scale(1) translateZ(0);
  }

  /* ── Text stagger pop-in ── */
  .hero-slide-label,
  .hero-slide-title,
  .hero-slide-subtitle {
    opacity: 0;
    transform: translateY(22px);
    transition-property: opacity, transform;
    transition-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
    transition-duration: 0.6s;
  }

  [data-slide][data-active="true"] .hero-slide-label {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0.22s;
  }
  [data-slide][data-active="true"] .hero-slide-title {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0.36s;
  }
  [data-slide][data-active="true"] .hero-slide-subtitle {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0.5s;
  }
</style>

<script>
  const roots = document.querySelectorAll<HTMLElement>("[data-hero-carousel]");

  roots.forEach((root) => {
    const slideEls = Array.from(root.querySelectorAll<HTMLElement>("[data-slide]"));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-dot]"));
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let current = 0;
    let timer: ReturnType<typeof setInterval> | null = null;

    const render = () => {
      slideEls.forEach((el, i) => {
        const offset = i === current ? "0" : i < current ? "-100%" : "100%";
        el.style.transform = `translateX(${offset})`;
        el.style.opacity = i === current ? "1" : "0";
        el.setAttribute("data-active", String(i === current));
      });
      dots.forEach((dot, i) => dot.setAttribute("data-active", String(i === current)));
    };

    const goTo = (index: number) => {
      current = (index + slideEls.length) % slideEls.length;
      render();
    };

    const start = () => {
      if (reduceMotion || timer) return;
      timer = setInterval(() => goTo(current + 1), 4500);
    };
    const stop = () => {
      if (timer) {
        clearInterval(timer);
        timer = null;
      }
    };

    dots.forEach((dot, i) =>
      dot.addEventListener("click", () => {
        goTo(i);
        stop();
        start();
      })
    );

    root.addEventListener("mouseenter", stop);
    root.addEventListener("mouseleave", start);

    let dragStartX: number | null = null;
    let dragStartY: number | null = null;
    let dragging = false;
    const SWIPE_THRESHOLD = 40;

    root.addEventListener("pointerdown", (e) => {
      dragStartX = e.clientX;
      dragStartY = e.clientY;
      dragging = true;
      stop();
      e.preventDefault();
    });

    root.addEventListener("pointerup", (e) => {
      if (!dragging || dragStartX === null || dragStartY === null) return;
      const deltaX = e.clientX - dragStartX;
      const deltaY = e.clientY - dragStartY;
      dragging = false;
      dragStartX = null;
      dragStartY = null;
      if (Math.abs(deltaX) > SWIPE_THRESHOLD && Math.abs(deltaX) > Math.abs(deltaY)) {
        goTo(current + (deltaX < 0 ? 1 : -1));
      }
      start();
    });

    root.addEventListener("pointercancel", () => {
      dragging = false;
      dragStartX = null;
      dragStartY = null;
      start();
    });

    // Double rAF ensures initial CSS paint (all hidden) happens before
    // render() sets data-active, so the stagger transition fires on load
    requestAnimationFrame(() => requestAnimationFrame(() => render()));
    start();
  });
</script>
