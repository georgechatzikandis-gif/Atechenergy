---
import { withBase } from "../lib/paths";
---

<section id="lithiumvalley" class="relative overflow-hidden bg-navy-950 py-24 sm:py-32 xl:py-40">
  <!-- Subtle green glow -->
  <div class="pointer-events-none absolute inset-0" style="background:radial-gradient(ellipse 70% 60% at 50% 50%, rgba(52,211,153,0.07) 0%, transparent 70%)"></div>

  <!-- Partner badge top left -->
  <div class="pointer-events-none absolute left-5 top-5 z-30 flex items-center gap-2 rounded-full border border-white/20 bg-black/40 px-3 py-1.5 backdrop-blur-sm">
    <span class="h-2 w-2 rounded-full animate-pulse" style="background-color:#34d399"></span>
    <span class="text-[10px] font-bold tracking-widest uppercase text-white/80">Συνεργάτης</span>
  </div>

  <div class="container-page relative z-10">
    <div class="mx-auto max-w-5xl text-center" data-reveal>

      <!-- LithiumValley Logo -->
      <div class="lv-logo mx-auto mb-8 inline-flex select-none items-baseline leading-none">
        <span class="lv-blue">
          <sup class="lv-sup">+</sup>L<span class="lv-i">I<span class="lv-bar">−</span></span>THIUM</span><span class="lv-green">VALLEY</span>
      </div>

      <!-- ΕΠΙΣΗΜΟΣ ΣΥΝΕΡΓΑΤΗΣ -->
      <div class="flex items-center justify-center gap-4">
        <span class="h-px w-16 bg-gradient-to-r from-transparent" style="background-image:linear-gradient(to right, transparent, #34d399)"></span>
        <p class="text-sm font-black tracking-[0.3em] uppercase" style="color:#34d399">ΕΠΙΣΗΜΟΣ ΣΥΝΕΡΓΑΤΗΣ</p>
        <span class="h-px w-16" style="background-image:linear-gradient(to left, transparent, #34d399)"></span>
      </div>

    </div>
  </div>
</section>

<section class="relative overflow-hidden bg-navy-950 pt-0 pb-20 sm:pb-24 xl:pb-28 2xl:pb-32">
  <div class="container-page relative z-10">
    <div class="mx-auto max-w-3xl text-center xl:max-w-4xl 2xl:max-w-5xl" data-reveal>
      <span class="eyebrow border-white/25 bg-white/10 backdrop-blur-sm" style="color:#6ee7b7">Λύσεις Αποθήκευσης Ενέργειας</span>

      <h2 class="mt-5 font-display text-4xl leading-[1.08] font-extrabold tracking-tight text-white sm:text-5xl lg:text-[3.4rem] xl:text-6xl 2xl:text-7xl 3xl:text-8xl">
        Lithium Valley —
        <span class="bg-gradient-to-r bg-clip-text text-transparent" style="background-image:linear-gradient(to right,#6ee7b7,#34d399,#ffffff)">
          Μπαταρίες Νέας Γενιάς
        </span>
      </h2>

      <p class="mx-auto mt-5 max-w-xl text-base leading-relaxed text-white/75 sm:text-lg xl:text-xl xl:max-w-2xl 2xl:text-2xl 2xl:max-w-3xl">
        Συστήματα αποθήκευσης λιθίου για κατοικίες, βιομηχανικές εγκαταστάσεις και ναυτιλιακές
        εφαρμογές. Αξιόπιστη τεχνολογία LiFePO₄ με υψηλή ασφάλεια και μακρά διάρκεια ζωής.
      </p>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <a href="#contact" class="btn btn-primary">
          Ζητήστε Προσφορά
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6"></path>
          </svg>
        </a>
        <a href={withBase("products/")} class="btn btn-ghost">Δείτε τα Προϊόντα</a>
      </div>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-x-3 gap-y-1.5 border-t border-white/10 pt-5 text-center">
        <span class="text-xs font-bold tracking-wide text-white/90">LiFePO₄ Technology</span>
        <span class="h-3 w-px bg-white/20" aria-hidden="true"></span>
        <span class="text-xs font-bold tracking-wide" style="color:#6ee7b7">Επίσημος Συνεργάτης</span>
        <span class="h-3 w-px bg-white/20" aria-hidden="true"></span>
        <span class="text-xs font-bold tracking-wide text-white/90">Home · C&amp;I · Marine</span>
      </div>
    </div>
  </div>
</section>

<style>
  .lv-logo {
    font-family: 'Arial Black', 'Arial', sans-serif;
    font-weight: 900;
    font-size: clamp(2.8rem, 9vw, 7.5rem);
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .lv-blue { color: #1B44C7; }
  .lv-green { color: #3DB63D; }
  .lv-sup {
    font-size: 0.3em;
    vertical-align: super;
    line-height: 0;
    margin-right: 0.04em;
  }
  .lv-i {
    display: inline-block;
    position: relative;
  }
  .lv-bar {
    position: absolute;
    top: -0.55em;
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.32em;
    line-height: 0;
    font-weight: 900;
  }
</style>
