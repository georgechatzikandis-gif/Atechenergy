---
interface Props {
  id: string;
  class?: string;
  opacity?: number;
}
const { id, class: className = "", opacity = 0.35 } = Astro.props;
---

<svg class={`pointer-events-none absolute inset-0 h-full w-full ${className}`} aria-hidden="true">
  <defs>
    <pattern id={id} width="56" height="56" patternUnits="userSpaceOnUse">
      <path d="M56 0H0V56" fill="none" stroke="currentColor" stroke-width="1"></path>
    </pattern>
    <radialGradient id={`${id}-fade`} cx="50%" cy="35%" r="65%">
      <stop offset="0%" stop-color="white" stop-opacity="1"></stop>
      <stop offset="100%" stop-color="white" stop-opacity="0"></stop>
    </radialGradient>
    <mask id={`${id}-mask`}>
      <rect width="100%" height="100%" fill={`url(#${id}-fade)`}></rect>
    </mask>
  </defs>
  <rect width="100%" height="100%" fill={`url(#${id})`} opacity={opacity} mask={`url(#${id}-mask)`}></rect>
</svg>
