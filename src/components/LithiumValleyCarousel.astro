---
import { Image } from "astro:assets";
import homeStorage from "../assets/lithiumvalley/lv-home-storage.jpg";
import ciStorage from "../assets/lithiumvalley/lv-ci-storage.jpg";
import marineBattery from "../assets/lithiumvalley/lv-marine-battery.jpg";

const slides = [
  {
    image: homeStorage,
    alt: "Lithium Valley Home Energy Storage System",
    width: 896,
    height: 1200,
    label: "Αποθήκευση Κατοικιών",
    title: "Home Energy Storage",
    subtitle: "Solar Integration · Stackable Battery · Off-Grid Ready",
  },
  {
    image: ciStorage,
    alt: "Lithium Valley Commercial & Industrial Storage",
    width: 896,
    height: 1200,
    label: "Βιομηχανική Αποθήκευση",
    title: "C&I Storage Systems",
    subtitle: "High Capacity · Industrial Grade · Reliable Performance",
  },
  {
    image: marineBattery,
    alt: "Lithium Valley Marine Battery Pro 12V 100Ah",
    width: 896,
    height: 1200,
    label: "Ναυτιλιακές Λύσεις",
    title: "Marine Battery Pro",
    subtitle: "12V 100Ah · Deep Cycle · Built for the Open Sea",
  },
];
---

<div class="relative h-full w-full touch-pan-y overflow-hidden bg-navy-950 select-none" data-hero-carousel data-lv>
  {
    slides.map((s, i) => (
      <div
        class="absolute inset-0 transition-all duration-700 ease-out"
        data-slide
        style={`transform:translateX(${i === 0 ? "0" : "100%"});opacity:${i === 0 ? "1" : "0"}`}
      >
        <Image
          src={s.image}
          alt={s.alt}
          width={s.width}
          height={s.height}
          loading={i === 0 ? "eager" : "lazy"}
          draggable={false}
          class="h-full w-full object-cover object-center [-webkit-user-drag:none]"
        />

        {/* Bottom gradient for text readability */}
        <div class="pointer-events-none absolute inset-x-0 bottom-0 h-72 bg-gradient-to-t from-black/75 via-black/30 to-transparent" />

        {/* Product details */}
        <div class="slide-text absolute inset-x-0 bottom-14 z-10 px-6 sm:px-10">
          <span class="hero-slide-label block text-[11px] font-bold tracking-[0.2em] uppercase mb-2" style="color:#6ee7b7">
            {s.label}
          </span>
          <h2 class="hero-slide-title text-[1.6rem] sm:text-3xl lg:text-4xl font-extrabold text-white leading-tight">
            {s.title}
          </h2>
          <p class="hero-slide-subtitle mt-1.5 text-sm sm:text-base text-white/70 font-medium">
            {s.subtitle}
          </p>
        </div>
      </div>
    ))
  }

  <div class="absolute inset-x-0 bottom-4 z-20 flex justify-center gap-2">
    {
      slides.map((_, i) => (
        <button
          type="button"
          class="h-2 w-2 rounded-full bg-white/60 shadow transition-all duration-300 data-[active=true]:w-7 data-[active=true]:bg-white"
          data-dot={i}
          data-active={i === 0}
          aria-label={`Προβολή διαφάνειας ${i + 1}`}
        />
      ))
    }
  </div>
</div>

<style is:global>
  @keyframes lv-ken-burns {
    from { transform: scale(1) translateZ(0); }
    to   { transform: scale(1.09) translateZ(0); }
  }

  [data-hero-carousel][data-lv] [data-slide][data-active="true"] img {
    animation: lv-ken-burns 5.5s ease-out forwards;
    will-change: transform;
  }
  [data-hero-carousel][data-lv] [data-slide]:not([data-active="true"]) img {
    animation: none;
    transform: scale(1) translateZ(0);
  }

  .hero-slide-label,
  .hero-slide-title,
  .hero-slide-subtitle {
    opacity: 0;
    transform: translateY(22px);
    transition-property: opacity, transform;
    transition-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
    transition-duration: 0.6s;
  }

  [data-hero-carousel][data-lv] [data-slide][data-active="true"] .hero-slide-label {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0.22s;
  }
  [data-hero-carousel][data-lv] [data-slide][data-active="true"] .hero-slide-title {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0.36s;
  }
  [data-hero-carousel][data-lv] [data-slide][data-active="true"] .hero-slide-subtitle {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0.5s;
  }
</style>

<script>
  const roots = document.querySelectorAll<HTMLElement>("[data-hero-carousel]:not([data-carousel-init])");

  roots.forEach((root) => {
    root.setAttribute("data-carousel-init", "true");
    const slideEls = Array.from(root.querySelectorAll<HTMLElement>("[data-slide]"));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-dot]"));
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let current = 0;
    let timer: ReturnType<typeof setInterval> | null = null;

    const render = () => {
      slideEls.forEach((el, i) => {
        const offset = i === current ? "0" : i < current ? "-100%" : "100%";
        el.style.transform = `translateX(${offset})`;
        el.style.opacity = i === current ? "1" : "0";
        el.setAttribute("data-active", String(i === current));
      });
      dots.forEach((dot, i) => dot.setAttribute("data-active", String(i === current)));
    };

    const goTo = (index: number) => {
      current = (index + slideEls.length) % slideEls.length;
      render();
    };

    const start = () => {
      if (reduceMotion || timer) return;
      timer = setInterval(() => goTo(current + 1), 4500);
    };
    const stop = () => {
      if (timer) {
        clearInterval(timer);
        timer = null;
      }
    };

    dots.forEach((dot, i) =>
      dot.addEventListener("click", () => {
        goTo(i);
        stop();
        start();
      })
    );

    root.addEventListener("mouseenter", stop);
    root.addEventListener("mouseleave", start);

    let dragStartX: number | null = null;
    let dragStartY: number | null = null;
    let dragging = false;
    const SWIPE_THRESHOLD = 40;

    root.addEventListener("pointerdown", (e) => {
      dragStartX = e.clientX;
      dragStartY = e.clientY;
      dragging = true;
      stop();
      e.preventDefault();
    });

    root.addEventListener("pointerup", (e) => {
      if (!dragging || dragStartX === null || dragStartY === null) return;
      const deltaX = e.clientX - dragStartX;
      const deltaY = e.clientY - dragStartY;
      dragging = false;
      dragStartX = null;
      dragStartY = null;
      if (Math.abs(deltaX) > SWIPE_THRESHOLD && Math.abs(deltaX) > Math.abs(deltaY)) {
        goTo(current + (deltaX < 0 ? 1 : -1));
      }
      start();
    });

    root.addEventListener("pointercancel", () => {
      dragging = false;
      dragStartX = null;
      dragStartY = null;
      start();
    });

    requestAnimationFrame(() => requestAnimationFrame(() => render()));
    start();
  });
</script>
