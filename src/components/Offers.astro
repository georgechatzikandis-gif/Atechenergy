<section class="bg-white py-10 sm:py-12 text-center" data-reveal>
  <div class="container-page">
    <button id="offers-btn" type="button" class="btn btn-outline">
      <span data-i18n="offers.button">Προσφορές</span>
    </button>
    <p id="offers-msg" class="mt-3 text-sm font-bold tracking-wide text-azure-600 hidden" data-i18n="offers.underConstruction">
      Υπό Κατασκευή
    </p>
  </div>
</section>

<script>
  const btn = document.getElementById("offers-btn");
  const msg = document.getElementById("offers-msg");
  btn?.addEventListener("click", () => {
    msg?.classList.remove("hidden");
  });
</script>
