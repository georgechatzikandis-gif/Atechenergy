---
interface Props {
  variant?: "dark" | "light";
  size?: "sm" | "md";
  class?: string;
}
const { variant = "dark", size = "md", class: className = "" } = Astro.props;
const markSize = size === "sm" ? "h-6 w-auto shrink-0 sm:h-7" : "h-8 w-auto shrink-0 sm:h-9";
const textSize = size === "sm" ? "text-base sm:text-lg" : "text-xl sm:text-2xl";
const gap = size === "sm" ? "gap-2" : "gap-2.5";
---

<span class={`inline-flex items-center ${gap} ${className}`}>
  <svg
    viewBox="0 0 120 108"
    class={markSize}
    role="img"
    aria-label="Alphatech logomark"
  >
    <defs>
      <linearGradient id="atech-mark" x1="8%" y1="95%" x2="98%" y2="5%">
        <stop offset="0%" stop-color="#0d2249"></stop>
        <stop offset="48%" stop-color="#1f5fa8"></stop>
        <stop offset="100%" stop-color="#5aa9f0"></stop>
      </linearGradient>
    </defs>
    <path
      fill="url(#atech-mark)"
      fill-rule="evenodd"
      d="M60 4 L114 100 L72 100 L60 76 L48 100 L6 100 Z"
    ></path>
    <path fill="#0d2249" d="M60 58 L76 100 L44 100 Z"></path>
  </svg>
  <span
    class={`font-display font-extrabold tracking-tight ${textSize} ${variant === "dark" ? "text-navy-900" : "text-white"}`}
  >
    ALPHA<span class="bg-gradient-to-r from-azure-500 to-azure-300 bg-clip-text text-transparent">TECH</span>
  </span>
</span>
