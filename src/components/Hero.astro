---
import GridPattern from "./GridPattern.astro";
import HeroCarousel from "./HeroCarousel.astro";
import { withBase } from "../lib/paths";

const badges = [
  { label: "Αξιόπιστα Προϊόντα", icon: "shield" },
  { label: "Εγγύηση Κορυφαίας Ποιότητας", icon: "award" },
  { label: "Βιώσιμη Ενέργεια", icon: "leaf" },
  { label: "Σεβασμός στο Περιβάλλον", icon: "globe" },
];

const icons: Record<string, string> = {
  shield: "M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z",
  award: "M12 15a6 6 0 1 0 0-12 6 6 0 0 0 0 12ZM8.5 13.5 7 22l5-3 5 3-1.5-8.5",
  leaf: "M11 20A9 9 0 0 1 2 11c5 0 9-4 9-9a9 9 0 0 1 9 9c-5 0-9 4-9 9Z",
  globe: "M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20ZM2 12h20M12 2a15 15 0 0 1 4 10 15 15 0 0 1-4 10 15 15 0 0 1-4-10 15 15 0 0 1 4-10Z",
};
---

<section id="home" class="relative isolate overflow-hidden bg-white pt-40 pb-28 sm:pt-48 sm:pb-32">
  <div class="absolute inset-0 -z-20 bg-[radial-gradient(ellipse_at_top_left,_var(--color-ice-200),_transparent_55%),radial-gradient(ellipse_at_bottom_right,_var(--color-ice-100),_transparent_55%)]"></div>
  <GridPattern id="hero-grid" class="text-navy-900 -z-10" opacity={0.06} />

  <div class="pointer-events-none absolute -top-24 -left-32 -z-10 h-[28rem] w-[28rem] rounded-full" style="background:radial-gradient(circle, color-mix(in srgb, var(--color-azure-500) 22%, transparent) 0%, transparent 70%)"></div>
  <div class="pointer-events-none absolute top-1/3 -right-24 -z-10 h-96 w-96 rounded-full" style="background:radial-gradient(circle, color-mix(in srgb, var(--color-gold-400) 14%, transparent) 0%, transparent 70%)"></div>

  <div class="container-page relative">
    <div class="mx-auto max-w-2xl" data-reveal>
      <HeroCarousel />
    </div>

    <div class="mx-auto mt-14 max-w-3xl text-center" data-reveal>
      <span class="eyebrow border-azure-500/20 bg-azure-500/10 text-azure-600">Ενέργεια για ένα Βιώσιμο Μέλλον</span>

      <h1 class="mt-6 font-display text-4xl leading-[1.08] font-extrabold tracking-tight text-navy-900 sm:text-5xl lg:text-[3.4rem]">
        Αξιόπιστες Ενεργειακές Λύσεις για
        <span class="bg-gradient-to-r from-azure-600 via-azure-500 to-navy-700 bg-clip-text text-transparent">
          Φωτοβολταϊκά Έργα
        </span>
      </h1>

      <p class="mx-auto mt-6 max-w-xl text-lg leading-relaxed text-navy-900/60">
        Φωτοβολταϊκά πάνελ, inverters, μπαταρίες αποθήκευσης και φορτιστές EV από κορυφαίους
        κατασκευαστές — με τεχνική υποστήριξη και ανταγωνιστικές τιμές, σε όλη την Ευρώπη
        και τη Λατινική Αμερική.
      </p>

      <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
        <a href="#contact" class="btn btn-primary">
          Ζητήστε Προσφορά
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6"></path>
          </svg>
        </a>
        <a href={withBase("products/")} class="btn btn-outline">Δείτε τα Προϊόντα</a>
      </div>

      <dl class="mt-16 grid grid-cols-2 gap-x-6 gap-y-5 sm:grid-cols-4 sm:gap-x-4">
        {
          badges.map((b) => (
            <div class="flex items-start gap-2.5 sm:flex-col sm:items-center sm:text-center">
              <svg class="mt-0.5 h-5 w-5 shrink-0 text-azure-500 sm:mt-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d={icons[b.icon]}></path>
              </svg>
              <dt class="text-sm leading-snug font-medium text-navy-900/70">{b.label}</dt>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>
