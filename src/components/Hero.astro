---
import GridPattern from "./GridPattern.astro";
import { withBase } from "../lib/paths";

const badges = [
  { label: "Αξιόπιστα Προϊόντα", icon: "shield" },
  { label: "Εγγύηση Κορυφαίας Ποιότητας", icon: "award" },
  { label: "Βιώσιμη Ενέργεια", icon: "leaf" },
  { label: "Σεβασμός στο Περιβάλλον", icon: "globe" },
];

const icons: Record<string, string> = {
  shield: "M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z",
  award: "M12 15a6 6 0 1 0 0-12 6 6 0 0 0 0 12ZM8.5 13.5 7 22l5-3 5 3-1.5-8.5",
  leaf: "M11 20A9 9 0 0 1 2 11c5 0 9-4 9-9a9 9 0 0 1 9 9c-5 0-9 4-9 9Z",
  globe: "M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20ZM2 12h20M12 2a15 15 0 0 1 4 10 15 15 0 0 1-4 10 15 15 0 0 1-4-10 15 15 0 0 1 4-10Z",
};

const stats = [
  { value: "2008", label: "Έτος Ίδρυσης" },
  { value: "2", label: "Ήπειροι Διανομής" },
  { value: "4+", label: "Επίσημες Συνεργασίες" },
];
---

<section id="home" class="relative isolate overflow-hidden bg-navy-950 pt-40 pb-28 sm:pt-48 sm:pb-32">
  <div class="absolute inset-0 -z-20 bg-[radial-gradient(ellipse_at_top_left,_var(--color-navy-700),_transparent_55%),radial-gradient(ellipse_at_bottom_right,_var(--color-navy-800),_transparent_55%)]"></div>
  <GridPattern id="hero-grid" class="text-white -z-10" opacity={0.12} />

  <div class="pointer-events-none absolute -top-24 -left-32 -z-10 h-[28rem] w-[28rem] rounded-full" style="background:radial-gradient(circle, color-mix(in srgb, var(--color-azure-500) 35%, transparent) 0%, transparent 70%)"></div>
  <div class="pointer-events-none absolute top-1/3 -right-24 -z-10 h-96 w-96 rounded-full" style="background:radial-gradient(circle, color-mix(in srgb, var(--color-gold-400) 16%, transparent) 0%, transparent 70%)"></div>

  <div class="container-page relative grid gap-16 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
    <div class="max-w-3xl" data-reveal>
      <span class="eyebrow border-white/20 bg-white/10 text-azure-200">Ενέργεια για ένα Βιώσιμο Μέλλον</span>

      <h1 class="mt-6 font-display text-4xl leading-[1.08] font-extrabold tracking-tight text-white sm:text-5xl lg:text-[3.4rem]">
        Αξιόπιστες Ενεργειακές Λύσεις για
        <span class="bg-gradient-to-r from-azure-300 via-azure-400 to-ice-200 bg-clip-text text-transparent">
          Φωτοβολταϊκά Έργα
        </span>
      </h1>

      <p class="mt-6 max-w-xl text-lg leading-relaxed text-white/70">
        Φωτοβολταϊκά πάνελ, inverters, μπαταρίες αποθήκευσης και φορτιστές EV από κορυφαίους
        κατασκευαστές — με τεχνική υποστήριξη και ανταγωνιστικές τιμές, σε όλη την Ευρώπη
        και τη Λατινική Αμερική.
      </p>

      <div class="mt-10 flex flex-wrap items-center gap-4">
        <a href="#contact" class="btn btn-primary">
          Ζητήστε Προσφορά
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6"></path>
          </svg>
        </a>
        <a href={withBase("products/")} class="btn btn-ghost">Δείτε τα Προϊόντα</a>
      </div>

      <dl class="mt-16 grid grid-cols-2 gap-x-6 gap-y-5 sm:grid-cols-4 sm:gap-x-4">
        {
          badges.map((b) => (
            <div class="flex items-start gap-2.5">
              <svg class="mt-0.5 h-5 w-5 shrink-0 text-azure-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d={icons[b.icon]}></path>
              </svg>
              <dt class="text-sm leading-snug font-medium text-white/75">{b.label}</dt>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="relative hidden lg:block" data-reveal>
      <div class="relative mx-auto aspect-square max-w-md">
        <div class="absolute inset-6 rounded-[2.5rem] border border-white/10 bg-gradient-to-br from-white/[0.08] to-transparent"></div>
        <div class="absolute inset-14 rounded-[2rem] border border-azure-300/20"></div>

        <svg viewBox="0 0 200 200" class="absolute inset-0 h-full w-full text-azure-300/70" aria-hidden="true">
          <g fill="none" stroke="currentColor" stroke-width="0.75">
            <rect x="55" y="55" width="90" height="90" rx="4"></rect>
            <path d="M55 78h90M55 100h90M55 122h90M78 55v90M100 55v90M122 55v90"></path>
          </g>
        </svg>

        <div class="absolute top-2 left-0 w-48 rounded-2xl border border-white/15 bg-navy-900/70 p-4 shadow-glow animate-float">
          <p class="font-display text-3xl font-extrabold text-white">{stats[0].value}</p>
          <p class="mt-1 text-xs font-medium tracking-wide text-white/60">{stats[0].label}</p>
        </div>

        <div class="absolute right-0 top-1/2 w-44 -translate-y-1/2 rounded-2xl border border-white/15 bg-navy-900/70 p-4 shadow-glow [animation-delay:-2s] animate-float">
          <p class="font-display text-3xl font-extrabold text-white">{stats[1].value}</p>
          <p class="mt-1 text-xs font-medium tracking-wide text-white/60">{stats[1].label}</p>
        </div>

        <div class="absolute bottom-2 left-8 w-48 rounded-2xl border border-white/15 bg-navy-900/70 p-4 shadow-glow [animation-delay:-4s] animate-float">
          <p class="font-display text-3xl font-extrabold text-white">{stats[2].value}</p>
          <p class="mt-1 text-xs font-medium tracking-wide text-white/60">{stats[2].label}</p>
        </div>
      </div>
    </div>
  </div>

  <div class="absolute bottom-0 left-0 right-0 h-24 bg-gradient-to-t from-white to-transparent"></div>
</section>
