---
import { Image } from "astro:assets";
import { withBase } from "../lib/paths";
import HeroCarousel from "./HeroCarousel.astro";
import lvAward from "../assets/credentials/lv-distributor-award.jpg";
import risenCert from "../assets/credentials/risen-distributor-cert.jpg";
---

<section id="home" class="relative h-[100svh] min-h-[520px] bg-navy-950">
  <HeroCarousel />
</section>

<section class="relative overflow-hidden bg-navy-950 pt-36 pb-20 sm:pt-40 sm:pb-24 xl:pt-48 xl:pb-28 2xl:pt-56 2xl:pb-32">
  <div class="container-page relative z-10">
    <div class="mx-auto max-w-3xl text-center xl:max-w-4xl 2xl:max-w-5xl" data-reveal>
      <span class="eyebrow border-white/25 bg-white/10 text-azure-200 backdrop-blur-sm" data-i18n="hero.eyebrow">Ενέργεια για ένα Βιώσιμο Μέλλον</span>

      <h1 class="mt-5 font-display text-4xl leading-[1.08] font-extrabold tracking-tight text-white sm:text-5xl lg:text-[3.4rem] xl:text-6xl 2xl:text-7xl 3xl:text-8xl">
        <span data-i18n="hero.h1a">Αξιόπιστες Ενεργειακές Λύσεις για</span>
        <span class="bg-gradient-to-r from-azure-300 via-azure-200 to-white bg-clip-text text-transparent" data-i18n="hero.h1b">
          Φωτοβολταϊκά Έργα
        </span>
      </h1>

      <p class="mx-auto mt-5 max-w-xl text-base leading-relaxed text-white/75 sm:text-lg xl:text-xl xl:max-w-2xl 2xl:text-2xl 2xl:max-w-3xl" data-i18n="hero.desc">
        Φωτοβολταϊκά πάνελ, inverters, μπαταρίες αποθήκευσης και φορτιστές EV από κορυφαίους
        κατασκευαστές — με τεχνική υποστήριξη και ανταγωνιστικές τιμές, σε όλη την Ευρώπη
        και τη Λατινική Αμερική.
      </p>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <a href="#contact" class="btn btn-primary">
          <span data-i18n="hero.btn1">Ζητήστε Προσφορά</span>
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6"></path>
          </svg>
        </a>
        <a href={withBase("products/")} class="btn btn-ghost" data-i18n="hero.btn2">Δείτε τα Προϊόντα</a>
        <a href={withBase("calculator/")} class="inline-flex items-center gap-2 rounded-xl border border-[#00e5b4]/40 bg-[#00e5b4]/10 px-5 py-2.5 text-sm font-semibold text-[#00e5b4] transition-all hover:bg-[#00e5b4]/20 hover:border-[#00e5b4]/60">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
          </svg>
          C&I Calculator
        </a>
      </div>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-x-3 gap-y-1.5 border-t border-white/10 pt-5 text-center xl:mt-10 xl:pt-6">
        <span class="text-xs font-bold tracking-wide text-white/90 xl:text-sm" data-i18n="hero.stat1">2008 · Ίδρυση</span>
        <span class="h-3 w-px bg-white/20" aria-hidden="true"></span>
        <span class="text-xs font-bold tracking-wide text-azure-300" data-i18n="hero.stat2">Επίσημος Συνεργάτης Risen Energy</span>
        <span class="h-3 w-px bg-white/20" aria-hidden="true"></span>
        <span class="text-xs font-bold tracking-wide text-white/90" data-i18n="hero.stat3">2 Ήπειροι Διανομής</span>
        <span class="h-3 w-px bg-white/20" aria-hidden="true"></span>
        <!-- Hero language switcher -->
        <div class="relative" data-hero-lang-switcher>
          <button
            type="button"
            class="flex items-center gap-1 text-xs font-bold text-white/60 transition-colors hover:text-white"
            aria-label="Language / Γλώσσα"
            data-hero-lang-toggle
          >
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
            </svg>
            <span data-hero-lang-label>ΕΛ</span>
            <svg class="h-2.5 w-2.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
              <path d="M6 9l6 6 6-6"/>
            </svg>
          </button>
          <div
            class="pointer-events-none absolute bottom-full left-1/2 mb-2 -translate-x-1/2 min-w-[4.5rem] rounded-xl border border-white/10 bg-navy-900/95 py-1 opacity-0 shadow-2xl backdrop-blur-xl transition-all duration-200"
            data-hero-lang-dropdown
          >
            {[
              { code: "el", label: "ΕΛ" },
              { code: "en", label: "EN" },
              { code: "fr", label: "FR" },
              { code: "es", label: "ES" },
              { code: "it", label: "IT" },
            ].map((l) => (
              <button
                type="button"
                class="flex w-full items-center justify-center px-3 py-1.5 text-[12px] font-bold text-white/60 transition-colors hover:bg-white/10 hover:text-white data-[active=true]:text-azure-300"
                data-lang-btn={l.code}
                data-active={l.code === "el" ? "true" : "false"}
              >
                {l.label}
              </button>
            ))}
          </div>
        </div>
      </div>

      {/* Credential cards */}
      <div class="mt-10 border-t border-white/10 pt-8">
        <div class="mb-6 flex items-center justify-center gap-3">
          <span class="h-px w-10 bg-gradient-to-r from-transparent to-azure-300/60"></span>
          <p class="text-[11px] font-bold tracking-[0.25em] uppercase text-azure-300" data-i18n="hero.award">
            Επίσημη Αντιπροσωπεία & Βραβεία
          </p>
          <span class="h-px w-10 bg-gradient-to-l from-transparent to-azure-300/60"></span>
        </div>
        <div class="mx-auto grid max-w-sm grid-cols-2 gap-4 sm:max-w-md lg:max-w-2xl lg:gap-6">
          {/* Lithium Valley Award */}
          <div class="group overflow-hidden rounded-2xl shadow-2xl shadow-black/60 ring-1 ring-white/10 transition-transform duration-500 hover:scale-[1.02]">
            <Image
              src={lvAward}
              alt="Lithium Valley Official Distributor Award — Alphatech Co Ltd"
              width={600}
              height={600}
              class="h-full w-full object-cover object-center"
            />
          </div>
          {/* Risen Storage Certificate */}
          <div class="group overflow-hidden rounded-2xl bg-white p-2 shadow-2xl shadow-black/60 ring-1 ring-white/20 transition-transform duration-500 hover:scale-[1.02]">
            <Image
              src={risenCert}
              alt="Risen Storage Authorized Distributor Certificate — Alphatech Co Ltd"
              width={557}
              height={800}
              class="h-full w-full object-cover object-top"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const langLabels: Record<string, string> = { el: "ΕΛ", en: "EN", fr: "FR", es: "ES", it: "IT" };

  const heroToggle = document.querySelector<HTMLButtonElement>("[data-hero-lang-toggle]");
  const heroDropdown = document.querySelector<HTMLDivElement>("[data-hero-lang-dropdown]");
  const heroLabel = document.querySelector<HTMLSpanElement>("[data-hero-lang-label]");

  let dropOpen = false;
  const setDrop = (v: boolean) => {
    dropOpen = v;
    if (!heroDropdown) return;
    heroDropdown.classList.toggle("opacity-100", dropOpen);
    heroDropdown.classList.toggle("opacity-0", !dropOpen);
    heroDropdown.classList.toggle("pointer-events-auto", dropOpen);
    heroDropdown.classList.toggle("pointer-events-none", !dropOpen);
  };

  heroToggle?.addEventListener("click", (e) => { e.stopPropagation(); setDrop(!dropOpen); });
  document.addEventListener("click", () => setDrop(false));

  // Restore label from localStorage
  try {
    const saved = localStorage.getItem("lang") || "el";
    if (heroLabel) heroLabel.textContent = langLabels[saved] || saved.toUpperCase();
  } catch(_) {}
</script>
