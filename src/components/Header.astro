---
import Logo from "./Logo.astro";
import { base, withBase } from "../lib/paths";

const isHome = Astro.url.pathname === base;
const anchor = (id: string) => (isHome ? `#${id}` : withBase(`#${id}`));
const homeHref = isHome ? "#home" : base;

const navLinks = [
  { href: homeHref, label: "Αρχική" },
  { href: withBase("products/"), label: "Προϊόντα" },
  { href: anchor("why-us"), label: "Γιατί Εμάς" },
  { href: anchor("about"), label: "Σχετικά" },
  { href: anchor("faq"), label: "Ερωτήσεις" },
  { href: anchor("contact"), label: "Επικοινωνία" },
];
---

<header id="site-header" class="fixed inset-x-0 top-0 z-50">
  <div class="container-page">
    <div
      class="mt-4 flex items-center justify-between rounded-2xl border border-white/10 bg-navy-900/85 px-4 py-3 shadow-[0_8px_32px_-12px_rgba(5,11,22,0.5)] backdrop-blur-md sm:px-6"
    >
      <a href={homeHref} class="shrink-0" aria-label="Alphatech Energy — Αρχική">
        <Logo variant="light" />
      </a>

      <nav class="hidden items-center gap-1 lg:flex" aria-label="Κύρια πλοήγηση">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class="rounded-full px-4 py-2 text-sm font-medium text-white/80 transition-colors hover:bg-white/10 hover:text-white"
            >
              {link.label}
            </a>
          ))
        }
      </nav>

      <div class="hidden items-center gap-3 lg:flex">
        <a
          href="tel:+306976724504"
          class="flex items-center gap-2 text-sm font-semibold text-white/90 hover:text-white"
        >
          <svg class="h-4 w-4 text-azure-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.362 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.338 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"></path>
          </svg>
          +30 697 672 4504
        </a>
        <a href={anchor("contact")} class="btn btn-primary">Ζητήστε Προσφορά</a>
      </div>

      <button
        type="button"
        class="inline-flex h-10 w-10 items-center justify-center rounded-xl text-white lg:hidden"
        aria-label="Άνοιγμα μενού"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>

    <div
      id="mobile-menu"
      class="pointer-events-none mt-2 grid grid-rows-[0fr] rounded-2xl border border-white/10 bg-navy-900/95 opacity-0 shadow-2xl backdrop-blur-xl transition-all duration-300 ease-out lg:hidden"
      data-mobile-menu
    >
      <div class="overflow-hidden">
        <nav class="flex flex-col gap-1 p-4" aria-label="Πλοήγηση κινητού">
          {
            navLinks.map((link) => (
              <a
                href={link.href}
                class="rounded-xl px-4 py-3 text-base font-medium text-white/85 hover:bg-white/10 hover:text-white"
                data-mobile-link
              >
                {link.label}
              </a>
            ))
          }
          <a href="tel:+306976724504" class="mt-2 rounded-xl px-4 py-3 text-base font-semibold text-azure-300">
            +30 697 672 4504
          </a>
          <a href={anchor("contact")} class="btn btn-primary mt-2 justify-center" data-mobile-link>Ζητήστε Προσφορά</a>
        </nav>
      </div>
    </div>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const menu = document.querySelector<HTMLDivElement>("[data-mobile-menu]");
  const links = document.querySelectorAll<HTMLAnchorElement>("[data-mobile-link]");

  let open = false;
  const setOpen = (value: boolean) => {
    open = value;
    if (!menu || !toggle) return;
    menu.classList.toggle("grid-rows-[1fr]", open);
    menu.classList.toggle("grid-rows-[0fr]", !open);
    menu.classList.toggle("opacity-100", open);
    menu.classList.toggle("opacity-0", !open);
    menu.classList.toggle("pointer-events-auto", open);
    menu.classList.toggle("pointer-events-none", !open);
    toggle.setAttribute("aria-expanded", String(open));
  };

  toggle?.addEventListener("click", () => setOpen(!open));
  links.forEach((link) => link.addEventListener("click", () => setOpen(false)));
</script>
