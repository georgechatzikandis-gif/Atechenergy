---
interface Props {
  kind: "mono" | "topcon" | "hjt" | "battery" | "inverter" | "ev";
  class?: string;
}
const { kind, class: className = "" } = Astro.props;
const uid = Math.random().toString(36).slice(2, 9);

function hexPoints(cx: number, cy: number, r: number): string {
  return Array.from({ length: 6 }, (_, i) => {
    const angle = (Math.PI / 180) * (60 * i - 30);
    return `${(cx + r * Math.cos(angle)).toFixed(1)},${(cy + r * Math.sin(angle)).toFixed(1)}`;
  }).join(" ");
}
---

<svg viewBox="0 0 200 150" class={className} role="img" aria-hidden="true">
  <defs>
    <linearGradient id={`panel-${uid}`} x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1c3f7c" />
      <stop offset="100%" stop-color="#0a1628" />
    </linearGradient>
    <linearGradient id={`sheen-${uid}`} x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#ffffff" stop-opacity="0.35" />
      <stop offset="100%" stop-color="#ffffff" stop-opacity="0" />
    </linearGradient>
    <linearGradient id={`body-${uid}`} x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#16305e" />
      <stop offset="100%" stop-color="#0a1628" />
    </linearGradient>
  </defs>

  {
    kind === "mono" && (
      <g>
        <rect x="34" y="24" width="132" height="102" rx="6" fill={`url(#panel-${uid})`} stroke="#4a97ee" stroke-width="1.5" />
        {Array.from({ length: 5 }).map((_, r) => (
          <line x1={34} y1={24 + ((r + 1) * 102) / 6} x2={166} y2={24 + ((r + 1) * 102) / 6} stroke="#7cb9f5" stroke-opacity="0.4" stroke-width="1" />
        ))}
        {Array.from({ length: 3 }).map((_, c) => (
          <line x1={34 + ((c + 1) * 132) / 4} y1={24} x2={34 + ((c + 1) * 132) / 4} y2={126} stroke="#7cb9f5" stroke-opacity="0.4" stroke-width="1" />
        ))}
        <polygon points="34,24 90,24 60,126 34,126" fill={`url(#sheen-${uid})`} />
      </g>
    )
  }

  {
    kind === "hjt" && (
      <g>
        <rect x="34" y="24" width="132" height="102" rx="6" fill={`url(#panel-${uid})`} stroke="#4a97ee" stroke-width="1.5" />
        {Array.from({ length: 4 }).map((_, r) =>
          Array.from({ length: 6 }).map((_, c) => (
            <polygon
              points={hexPoints(46 + c * 20 + (r % 2 === 0 ? 0 : 10), 40 + r * 22, 9)}
              fill="none"
              stroke="#7cb9f5"
              stroke-opacity="0.45"
              stroke-width="1"
            />
          ))
        )}
        <polygon points="34,24 100,24 70,126 34,126" fill={`url(#sheen-${uid})`} />
      </g>
    )
  }

  {
    kind === "battery" && (
      <g>
        <rect x="20" y="16" width="12" height="16" rx="2" fill="#4a97ee" />
        <rect x="60" y="16" width="12" height="16" rx="2" fill="#4a97ee" />
        <rect x="50" y="28" width="100" height="106" rx="10" fill={`url(#body-${uid})`} stroke="#4a97ee" stroke-width="1.5" />
        <rect x="62" y="46" width="76" height="72" rx="4" fill="none" stroke="#7cb9f5" stroke-opacity="0.5" stroke-width="1" />
        <rect x="68" y="98" width="64" height="16" rx="2" fill="#2f7fe0" opacity="0.85" />
        <rect x="68" y="78" width="64" height="16" rx="2" fill="#2f7fe0" opacity="0.6" />
        <rect x="68" y="58" width="64" height="16" rx="2" fill="#2f7fe0" opacity="0.35" />
        <path d="M96 58 88 84h10l-8 26 24-34h-11l7-18Z" fill="#eaf4fe" />
      </g>
    )
  }

  {
    kind === "inverter" && (
      <g>
        <rect x="56" y="14" width="88" height="122" rx="8" fill={`url(#body-${uid})`} stroke="#4a97ee" stroke-width="1.5" />
        <rect x="68" y="26" width="64" height="40" rx="4" fill="#0d2249" stroke="#7cb9f5" stroke-opacity="0.5" />
        <polyline points="72,54 82,40 92,50 102,32 112,46 124,34" fill="none" stroke="#5aa9f0" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        <circle cx="72" cy="78" r="3" fill="#5aa9f0" />
        <circle cx="86" cy="78" r="3" fill="#7cb9f5" opacity="0.6" />
        {Array.from({ length: 5 }).map((_, i) => (
          <line x1={68} y1={98 + i * 6} x2={132} y2={98 + i * 6} stroke="#7cb9f5" stroke-opacity="0.35" stroke-width="1.5" />
        ))}
      </g>
    )
  }

  {
    kind === "ev" && (
      <g>
        <rect x="30" y="20" width="56" height="98" rx="10" fill={`url(#body-${uid})`} stroke="#4a97ee" stroke-width="1.5" />
        <rect x="40" y="34" width="36" height="24" rx="3" fill="#0d2249" stroke="#7cb9f5" stroke-opacity="0.5" />
        <path d="M62 36 52 50h7l-5 14 16-18h-8l5-10Z" fill="#eaf4fe" />
        <circle cx="58" cy="90" r="6" fill="#2f7fe0" />
        <path d="M86 70c22 4 34 16 40 40" fill="none" stroke="#4a97ee" stroke-width="4" stroke-linecap="round" />
        <circle cx="128" cy="112" r="12" fill="#0d2249" stroke="#5aa9f0" stroke-width="2" />
        <circle cx="128" cy="112" r="4" fill="#5aa9f0" />
      </g>
    )
  }
</svg>
