---
const accessKey = "a730cfba-9e29-4441-af93-5fe1ada52230";
---

<!-- Floating chat button -->
<button
  type="button"
  id="chat-btn"
  aria-label="Επικοινωνήστε μαζί μας"
  aria-expanded="false"
  aria-controls="chat-popup"
  class="chat-bubble group fixed bottom-20 right-5 z-50 flex h-14 w-14 items-center justify-center rounded-full shadow-lg shadow-black/40 transition-transform duration-200 hover:scale-110 active:scale-95 sm:bottom-24 sm:right-6"
>
  <span class="chat-pulse absolute inset-0 rounded-full opacity-60"></span>

  {/* Chat icon (default) */}
  <svg id="icon-msg" viewBox="0 0 24 24" fill="currentColor" class="relative h-7 w-7 text-white" aria-hidden="true">
    <path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z"/>
  </svg>

  {/* Close icon (shown when popup is open) */}
  <svg id="icon-x" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="relative hidden h-6 w-6 text-white" aria-hidden="true">
    <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
  </svg>

  {/* Tooltip */}
  <span class="pointer-events-none absolute right-16 whitespace-nowrap rounded-lg bg-[#7360f2] px-3 py-1.5 text-xs font-semibold text-white opacity-0 shadow-md transition-opacity duration-200 group-hover:opacity-100">
    Στείλτε μήνυμα
  </span>
</button>

<!-- Chat popup -->
<div
  id="chat-popup"
  role="dialog"
  aria-modal="true"
  aria-label="Γρήγορη Επικοινωνία"
  aria-hidden="true"
  class="fixed bottom-24 right-5 z-50 w-80 overflow-hidden rounded-2xl shadow-2xl ring-1 ring-white/10 sm:bottom-28 sm:right-6"
>
  {/* Header */}
  <div class="flex items-center gap-3 bg-gradient-to-r from-[#9b59b6] to-[#7360f2] px-4 py-3">
    <div class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-white/20 text-sm font-bold text-white">
      AE
    </div>
    <div>
      <p class="text-sm font-semibold text-white">Alphatech Energy</p>
      <p class="flex items-center gap-1.5 text-[11px] text-white/75">
        <span class="h-1.5 w-1.5 rounded-full bg-green-400"></span>
        Συνήθως απαντάμε σύντομα
      </p>
    </div>
  </div>

  {/* Body */}
  <div class="bg-[#0d1f3c] px-4 pb-4 pt-4">
    {/* Greeting bubble from company */}
    <div class="mb-4 flex items-end gap-2">
      <div class="flex h-7 w-7 flex-shrink-0 items-center justify-center rounded-full bg-[#7360f2] text-[10px] font-bold text-white">
        AE
      </div>
      <div class="max-w-[85%] rounded-2xl rounded-bl-sm bg-white/10 px-3 py-2 text-sm leading-relaxed text-white/90">
        Γεια σας! 👋 Πώς μπορούμε να σας βοηθήσουμε;
      </div>
    </div>

    {/* Contact form */}
    <form id="chat-form" novalidate data-key={accessKey}>
      <input
        type="text"
        name="name"
        id="chat-name"
        placeholder="Το όνομά σας"
        required
        autocomplete="name"
        class="mb-2 w-full rounded-xl border border-white/10 bg-white/5 px-3 py-2.5 text-sm text-white outline-none transition-colors placeholder:text-white/35 focus:border-[#7360f2] focus:ring-1 focus:ring-[#7360f2]"
      />
      <textarea
        name="message"
        id="chat-msg"
        placeholder="Γράψτε το μήνυμά σας..."
        rows="3"
        required
        class="mb-3 w-full resize-none rounded-xl border border-white/10 bg-white/5 px-3 py-2.5 text-sm text-white outline-none transition-colors placeholder:text-white/35 focus:border-[#7360f2] focus:ring-1 focus:ring-[#7360f2]"
      ></textarea>
      <button
        type="submit"
        id="chat-submit"
        class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#9b59b6] to-[#7360f2] py-2.5 text-sm font-semibold text-white transition-opacity hover:opacity-90 active:opacity-80 disabled:cursor-not-allowed disabled:opacity-50"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true">
          <line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/>
        </svg>
        <span id="chat-submit-label">Αποστολή</span>
      </button>
      <p id="chat-err" class="mt-2 hidden text-center text-xs text-red-400">
        Κάτι πήγε στραβά. Δοκιμάστε ξανά αργότερα.
      </p>
    </form>

    {/* Success state */}
    <div id="chat-ok" class="hidden">
      <div class="flex items-end gap-2">
        <div class="flex h-7 w-7 flex-shrink-0 items-center justify-center rounded-full bg-[#7360f2] text-[10px] font-bold text-white">
          AE
        </div>
        <div class="max-w-[85%] rounded-2xl rounded-bl-sm bg-white/10 px-3 py-2 text-sm leading-relaxed text-white/90">
          Ευχαριστούμε! 😊 Θα επικοινωνήσουμε μαζί σας σύντομα.
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .chat-bubble {
    background: linear-gradient(135deg, #9b59b6 0%, #7360f2 60%, #5b4de0 100%);
  }

  .chat-pulse {
    background: #7360f2;
    animation: chat-ring 2.4s ease-out infinite;
  }

  @keyframes chat-ring {
    0%   { transform: scale(1);    opacity: 0.55; }
    70%  { transform: scale(1.55); opacity: 0; }
    100% { transform: scale(1.55); opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .chat-pulse { animation: none; }
  }

  #chat-popup {
    transform-origin: bottom right;
    opacity: 0;
    transform: scale(0.88) translateY(12px);
    pointer-events: none;
    transition: opacity 0.22s ease, transform 0.22s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  #chat-popup.is-open {
    opacity: 1;
    transform: scale(1) translateY(0);
    pointer-events: auto;
  }
</style>

<script>
  const btn = document.getElementById("chat-btn")!;
  const popup = document.getElementById("chat-popup")!;
  const iconMsg = document.getElementById("icon-msg")!;
  const iconX = document.getElementById("icon-x")!;
  const form = document.getElementById("chat-form") as HTMLFormElement;
  const nameEl = document.getElementById("chat-name") as HTMLInputElement;
  const msgEl = document.getElementById("chat-msg") as HTMLTextAreaElement;
  const submitEl = document.getElementById("chat-submit") as HTMLButtonElement;
  const submitLabel = document.getElementById("chat-submit-label")!;
  const errEl = document.getElementById("chat-err")!;
  const okEl = document.getElementById("chat-ok")!;

  let isOpen = false;

  const openChat = () => {
    isOpen = true;
    popup.classList.add("is-open");
    popup.setAttribute("aria-hidden", "false");
    btn.setAttribute("aria-expanded", "true");
    iconMsg.classList.add("hidden");
    iconX.classList.remove("hidden");
    setTimeout(() => nameEl.focus(), 60);
  };

  const closeChat = () => {
    isOpen = false;
    popup.classList.remove("is-open");
    popup.setAttribute("aria-hidden", "true");
    btn.setAttribute("aria-expanded", "false");
    iconMsg.classList.remove("hidden");
    iconX.classList.add("hidden");
  };

  btn.addEventListener("click", () => (isOpen ? closeChat() : openChat()));

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && isOpen) closeChat();
  });

  document.addEventListener("pointerdown", (e) => {
    if (isOpen && !popup.contains(e.target as Node) && !btn.contains(e.target as Node)) {
      closeChat();
    }
  });

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    const name = nameEl.value.trim();
    const msg  = msgEl.value.trim();
    if (!name || !msg) return;

    const accessKey = form.dataset.key ?? "";

    submitEl.disabled = true;
    submitLabel.textContent = "Αποστολή...";
    errEl.classList.add("hidden");

    try {
      const res = await fetch("https://api.web3forms.com/submit", {
        method: "POST",
        headers: { "Content-Type": "application/json", Accept: "application/json" },
        body: JSON.stringify({
          access_key: accessKey,
          subject: `Μήνυμα chat από ${name}`,
          from_name: name,
          message: msg,
        }),
      });

      const data = await res.json();

      if (data.success) {
        form.classList.add("hidden");
        okEl.classList.remove("hidden");
      } else {
        throw new Error(data.message ?? "error");
      }
    } catch {
      errEl.classList.remove("hidden");
      submitEl.disabled = false;
      submitLabel.textContent = "Αποστολή";
    }
  });
</script>
