---
---

<a
  href="viber://chat?number=%2B306976724504"
  aria-label="Επικοινωνήστε μαζί μας στο Viber"
  class="viber-bubble group fixed bottom-6 right-5 z-50 flex h-14 w-14 items-center justify-center rounded-full shadow-lg shadow-black/40 transition-transform duration-200 hover:scale-110 active:scale-95 sm:bottom-8 sm:right-6"
>
  {/* Pulse ring */}
  <span class="viber-pulse absolute inset-0 rounded-full opacity-60"></span>

  {/* Viber icon */}
  <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" class="relative h-8 w-8" aria-hidden="true">
    <path fill-rule="evenodd" clip-rule="evenodd"
      d="M16 2C9.373 2 4 7.033 4 13.2c0 3.526 1.713 6.662 4.4 8.764V26l4.104-2.256A13.13 13.13 0 0016 24.4c6.627 0 12-5.033 12-11.2S22.627 2 16 2zm1.21 14.97-.744-.744c-.47-.47-1.18-.578-1.77-.261l-.41.22a1.49 1.49 0 01-1.746-.277l-1.448-1.449a1.49 1.49 0 01-.277-1.746l.22-.41c.317-.59.209-1.3-.26-1.77l-.745-.745c-.548-.548-1.45-.52-1.96.065C7.34 11.15 7 12.07 7 13c0 3.314 5.373 8 8.5 8 .93 0 1.85-.34 2.645-1.07.585-.51.613-1.412.065-1.96zm.893-3.647a.5.5 0 01-.493-.508 3.11 3.11 0 00-3.11-3.11.5.5 0 010-1 4.11 4.11 0 014.11 4.11.5.5 0 01-.507.508zm2.5.093a.5.5 0 01-.499-.501A5.614 5.614 0 0014.5 7.312a.5.5 0 010-1A6.614 6.614 0 0121.103 13.415a.5.5 0 01-.5.001z"
      fill="#fff"
    />
  </svg>

  {/* Tooltip */}
  <span class="pointer-events-none absolute right-16 whitespace-nowrap rounded-lg bg-[#7360f2] px-3 py-1.5 text-xs font-semibold text-white opacity-0 shadow-md transition-opacity duration-200 group-hover:opacity-100">
    Viber Chat
  </span>
</a>

<style>
  .viber-bubble {
    background: linear-gradient(135deg, #9b59b6 0%, #7360f2 60%, #5b4de0 100%);
  }

  .viber-pulse {
    background: #7360f2;
    animation: viber-ring 2.4s ease-out infinite;
  }

  @keyframes viber-ring {
    0%   { transform: scale(1);   opacity: 0.55; }
    70%  { transform: scale(1.55); opacity: 0; }
    100% { transform: scale(1.55); opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .viber-pulse { animation: none; }
  }
</style>
