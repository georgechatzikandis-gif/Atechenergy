---
const mapQuery = encodeURIComponent(
  "Alphatech Energy, 7o χλμ Θεσσαλονίκης - Καβάλας, Ευκαρπία 564 29, Θεσσαλονίκη"
);
---

<section id="contact" class="relative overflow-hidden bg-gradient-to-b from-ice-100/50 to-white py-24 sm:py-32 xl:py-40 2xl:py-48">
  <div class="container-page">
    <div class="overflow-hidden rounded-[2rem] bg-navy-950 shadow-2xl">
      <div class="grid lg:grid-cols-2">
        <div class="p-10 sm:p-14 xl:p-16 2xl:p-20" data-reveal>
          <span class="eyebrow border-white/20 bg-white/10 text-azure-200">Επικοινωνία</span>
          <h2 class="mt-5 font-display text-3xl font-extrabold tracking-tight text-white sm:text-4xl xl:text-5xl 2xl:text-6xl">
            Είμαστε εδώ για εσάς!
          </h2>
          <p class="mt-4 max-w-md text-white/65 xl:text-lg xl:max-w-lg 2xl:text-xl 2xl:max-w-xl">
            Έχετε κάποιο πλάνο στο μυαλό σας; Μπορούμε να σας βοηθήσουμε να το υλοποιήσετε —
            επικοινωνήστε μαζί μας.
          </p>

          <div class="mt-10 flex flex-col gap-4">
            <a href="tel:+306976724504" class="flex flex-1 items-center gap-4 rounded-2xl border border-white/10 bg-white/[0.04] p-5 transition-colors hover:bg-white/[0.08]">
              <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-azure-400 to-azure-600 text-white">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.362 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.338 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
                </svg>
              </span>
              <span>
                <span class="block text-xs font-semibold tracking-wide text-white/50 uppercase">Καλέστε μας</span>
                <span class="mt-0.5 block font-display font-bold text-white">+30 697 672 4504</span>
              </span>
            </a>

            <a href="mailto:info@atechenergy.eu" class="flex flex-1 items-center gap-4 rounded-2xl border border-white/10 bg-white/[0.04] p-5 transition-colors hover:bg-white/[0.08]">
              <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-azure-400 to-azure-600 text-white">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M3 5h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Zm0 0 9 8 9-8" />
                </svg>
              </span>
              <span>
                <span class="block text-xs font-semibold tracking-wide text-white/50 uppercase">Email μας</span>
                <span class="mt-0.5 block font-display font-bold text-white">info@atechenergy.eu</span>
              </span>
            </a>

            <a href="viber://chat?number=%2B306976724504" class="flex flex-1 items-center gap-4 rounded-2xl border border-white/10 bg-white/[0.04] p-5 transition-colors hover:bg-white/[0.08]">
              <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-azure-400 to-azure-600 text-white">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M21 11.5a8.5 8.5 0 0 1-8.5 8.5c-1.15 0-2.26-.23-3.27-.66L3 21l1.66-6.23A8.5 8.5 0 1 1 21 11.5Z" />
                </svg>
              </span>
              <span>
                <span class="block text-xs font-semibold tracking-wide text-white/50 uppercase">Viber · Τεχνική Υποστήριξη</span>
                <span class="mt-0.5 block font-display font-bold text-white">+30 697 672 4504</span>
              </span>
            </a>
          </div>

          <form
            action="mailto:info@atechenergy.eu"
            method="POST"
            enctype="text/plain"
            class="mt-10 grid gap-4"
          >
            <div class="grid gap-4 sm:grid-cols-2">
              <div>
                <label for="name" class="mb-1.5 block text-sm font-medium text-white/70">Ονοματεπώνυμο</label>
                <input id="name" name="Ονοματεπώνυμο" type="text" required autocomplete="name"
                  class="w-full rounded-xl border border-white/15 bg-white/[0.04] px-4 py-3 text-white placeholder-white/30 outline-none transition-colors focus:border-azure-400" placeholder="Το όνομά σας" />
              </div>
              <div>
                <label for="email" class="mb-1.5 block text-sm font-medium text-white/70">Email</label>
                <input id="email" name="Email" type="email" required autocomplete="email"
                  class="w-full rounded-xl border border-white/15 bg-white/[0.04] px-4 py-3 text-white placeholder-white/30 outline-none transition-colors focus:border-azure-400" placeholder="you@company.com" />
              </div>
            </div>
            <div>
              <label for="message" class="mb-1.5 block text-sm font-medium text-white/70">Μήνυμα</label>
              <textarea id="message" name="Μήνυμα" required rows="4"
                class="w-full resize-none rounded-xl border border-white/15 bg-white/[0.04] px-4 py-3 text-white placeholder-white/30 outline-none transition-colors focus:border-azure-400" placeholder="Περιγράψτε το έργο σας..."></textarea>
            </div>
            <button type="submit" class="btn btn-primary justify-center">Αποστολή Μηνύματος</button>
          </form>
        </div>

        <div class="relative min-h-[22rem] border-t border-white/10 lg:min-h-full lg:border-t-0 lg:border-l" data-reveal>
          <iframe
            title="Χάρτης τοποθεσίας Alphatech Energy"
            src={`https://www.google.com/maps?q=${mapQuery}&output=embed`}
            class="absolute inset-0 h-full w-full grayscale-[35%] contrast-[1.1] invert-[92%] hue-rotate-180"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
          <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-navy-950/40 via-transparent to-navy-950/20"></div>
        </div>
      </div>
    </div>
  </div>
</section>
