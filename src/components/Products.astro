---
import ProductArt from "./ProductArt.astro";

const products = [
  {
    name: "Μονοκρυσταλλικά Πάνελ",
    tag: "Monocrystalline PV Module",
    desc: "Υψηλής απόδοσης μονοκρυσταλλικά φωτοβολταϊκά πάνελ για οικιακές και εμπορικές εγκαταστάσεις.",
    art: "mono",
  },
  {
    name: "Topcon Πάνελ",
    tag: "Topcon Panels",
    desc: "Τεχνολογία αιχμής N-type με ενισχυμένη απόδοση και χαμηλότερη ετήσια φθορά.",
    art: "topcon",
  },
  {
    name: "HJT Πάνελ",
    tag: "Heterojunction Panels",
    desc: "Υβριδική τεχνολογία κελιών για μέγιστη απόδοση σε κάθε συνθήκη φωτισμού.",
    art: "hjt",
  },
  {
    name: "Μπαταρίες Αποθήκευσης",
    tag: "PV Storage Batteries",
    desc: "Συστήματα αποθήκευσης ενέργειας για αυτονομία και βελτιστοποίηση της κατανάλωσης.",
    art: "battery",
  },
  {
    name: "Inverters",
    tag: "Grid & Hybrid Inverters",
    desc: "Αξιόπιστοι μετατροπείς ισχύος από κορυφαίους κατασκευαστές, για κάθε τύπο έργου.",
    art: "inverter",
  },
  {
    name: "Φορτιστές EV",
    tag: "EV Chargers",
    desc: "Φορτιστές ηλεκτρικών οχημάτων για οικιακή και επαγγελματική χρήση.",
    art: "ev",
  },
] as const;

const specs = [
  { value: "132", label: "Cell Monocrystalline Module" },
  { value: "21.7%", label: "Μέγιστη Απόδοση" },
  { value: "2%", label: "Φθορά Πρώτου Έτους" },
  { value: "0.55%", label: "Ετήσια Φθορά" },
  { value: "1500 VDC", label: "Μέγιστη Τάση Συστήματος" },
  { value: "1754×1096×30", label: "Διαστάσεις Module (mm)" },
];
---

<section id="products" class="relative bg-gradient-to-b from-white to-ice-100/40 py-24 sm:py-32">
  <div class="container-page">
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <span class="eyebrow border-azure-500/20 text-azure-600">Τα Προϊόντα Μας</span>
      <h2 class="mt-5 font-display text-3xl font-extrabold tracking-tight text-navy-900 sm:text-4xl">
        Πλήρης γκάμα εξοπλισμού για κάθε φωτοβολταϊκό έργο
      </h2>
      <p class="mt-4 text-lg text-navy-900/60">
        Από πάνελ υψηλής απόδοσης έως συστήματα αποθήκευσης και φόρτισης — επιλεγμένα προϊόντα
        από κορυφαίους παγκόσμιους κατασκευαστές.
      </p>
    </div>

    <div class="mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        products.map((p, i) => (
          <div
            class="group relative overflow-hidden rounded-3xl border border-navy-900/8 bg-white shadow-card transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_24px_48px_-16px_rgba(47,127,224,0.25)]"
            data-reveal
            style={`transition-delay:${i * 60}ms`}
          >
            <div class="flex h-40 items-center justify-center bg-gradient-to-br from-ice-100 to-white">
              <ProductArt kind={p.art} class="h-32 w-auto transition-transform duration-500 group-hover:scale-105" />
            </div>
            <div class="p-8 pt-6">
              <p class="text-xs font-bold tracking-[0.14em] text-azure-600 uppercase">{p.tag}</p>
              <h3 class="mt-2 font-display text-xl font-bold text-navy-900">{p.name}</h3>
              <p class="mt-3 text-sm leading-relaxed text-navy-900/60">{p.desc}</p>
            </div>
          </div>
        ))
      }
    </div>

    <div class="mt-10 overflow-hidden rounded-[2rem] bg-navy-950 shadow-2xl" data-reveal>
      <div class="grid gap-10 p-10 sm:p-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
        <div>
          <span class="eyebrow border-white/20 bg-white/10 text-azure-200">Προτεινόμενο Προϊόν</span>
          <h3 class="mt-5 font-display text-2xl font-extrabold text-white sm:text-3xl">
            Titan 675Wp+ <span class="text-azure-300">(655–675 WP)</span>
          </h3>
          <p class="mt-4 text-white/65">
            Μονοκρυσταλλικό module υψηλής ισχύος σχεδιασμένο για μεγιστοποίηση της απόδοσης σε
            εμπορικά και βιομηχανικά φωτοβολταϊκά έργα.
          </p>
          <a href="#contact" class="btn btn-primary mt-8">Ζητήστε Τεχνικό Φυλλάδιο</a>
        </div>
        <div class="grid grid-cols-2 gap-4 sm:grid-cols-3">
          {
            specs.map((s) => (
              <div class="rounded-2xl border border-white/10 bg-white/[0.04] p-5">
                <p class="font-display text-xl font-extrabold text-white">{s.value}</p>
                <p class="mt-1.5 text-xs leading-snug text-white/55">{s.label}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
