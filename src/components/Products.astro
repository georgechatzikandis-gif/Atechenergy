---
import { Image } from "astro:assets";
import ProductArt from "./ProductArt.astro";
import { products } from "../data/products";
import { withBase } from "../lib/paths";

const specs = [
  { value: "132", label: "Cell Monocrystalline Module", key: "products.spec0" },
  { value: "21.7%", label: "Μέγιστη Απόδοση", key: "products.spec1" },
  { value: "2%", label: "Φθορά Πρώτου Έτους", key: "products.spec2" },
  { value: "0.55%", label: "Ετήσια Φθορά", key: "products.spec3" },
  { value: "1500 VDC", label: "Μέγιστη Τάση Συστήματος", key: "products.spec4" },
  { value: "1754×1096×30", label: "Διαστάσεις Module (mm)", key: "products.spec5" },
];
---

<section id="products" class="relative bg-gradient-to-b from-white to-ice-100/40 py-24 sm:py-32">
  <div class="container-page">
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <span class="eyebrow border-azure-500/20 text-azure-600" data-i18n="products.eyebrow">Τα Προϊόντα Μας</span>
      <h2 class="mt-5 font-display text-3xl font-extrabold tracking-tight text-navy-900 sm:text-4xl" data-i18n="products.h2">
        Πλήρης γκάμα εξοπλισμού για κάθε φωτοβολταϊκό έργο
      </h2>
      <p class="mt-4 text-lg text-navy-900/60" data-i18n="products.desc">
        Από πάνελ υψηλής απόδοσης έως συστήματα αποθήκευσης και φόρτισης — επιλεγμένα προϊόντα
        από κορυφαίους παγκόσμιους κατασκευαστές.
      </p>
    </div>

    <div class="mt-16 flex justify-center">
      {(() => {
        const p = products[0];
        return (
          <a
            href={withBase(`products/${p.slug}/`)}
            class="group relative w-full max-w-sm overflow-hidden rounded-3xl border border-navy-900/8 bg-white shadow-card transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_24px_48px_-16px_rgba(47,127,224,0.25)]"
            data-reveal
          >
            <div class="flex h-40 items-center justify-center overflow-hidden bg-gradient-to-br from-ice-100 to-white">
              {p.photo ? (
                <Image
                  src={p.photo}
                  alt={p.name}
                  width={340}
                  height={220}
                  class="h-32 w-auto max-w-[85%] object-contain transition-transform duration-500 group-hover:scale-105"
                />
              ) : (
                <ProductArt kind={p.art!} class="h-32 w-auto transition-transform duration-500 group-hover:scale-105" />
              )}
            </div>
            <div class="p-8 pt-6">
              <p class="text-xs font-bold tracking-[0.14em] text-azure-600 uppercase">{p.tag}</p>
              {p.distributor && (
                <p class="mt-1.5 text-[11px] font-extrabold tracking-[0.12em] text-navy-900/75 uppercase">
                  {p.distributor}
                </p>
              )}
              <h3 class="mt-3 font-display text-xl font-bold text-navy-900">{p.name}</h3>
              <p class="mt-3 text-sm leading-relaxed text-navy-900/60">{p.desc}</p>
              <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-azure-600">
                <span data-i18n="products.more">Περισσότερα</span>
                <svg class="h-3.5 w-3.5 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
              </span>
            </div>
          </a>
        );
      })()}
    </div>

    <div class="mt-10 overflow-hidden rounded-[2rem] bg-navy-950 shadow-2xl" data-reveal>
      <div class="grid gap-10 p-10 sm:p-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
        <div>
          <span class="eyebrow border-white/20 bg-white/10 text-azure-200" data-i18n="products.featured.eyebrow">Προτεινόμενο Προϊόν</span>
          <h3 class="mt-5 font-display text-2xl font-extrabold text-white sm:text-3xl">
            Titan 675Wp+ <span class="text-azure-300">(655–675 WP)</span>
          </h3>
          <p class="mt-4 text-white/65" data-i18n="products.featured.desc">
            Μονοκρυσταλλικό module υψηλής ισχύος σχεδιασμένο για μεγιστοποίηση της απόδοσης σε
            εμπορικά και βιομηχανικά φωτοβολταϊκά έργα.
          </p>
          <a href="#contact" class="btn btn-primary mt-8" data-i18n="products.featured.btn">Ζητήστε Τεχνικό Φυλλάδιο</a>
        </div>
        <div class="grid grid-cols-2 gap-4 sm:grid-cols-3">
          {
            specs.map((s) => (
              <div class="rounded-2xl border border-white/10 bg-white/[0.04] p-5">
                <p class="font-display text-xl font-extrabold text-white">{s.value}</p>
                <p class="mt-1.5 text-xs leading-snug text-white/55" data-i18n={s.key}>{s.label}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
