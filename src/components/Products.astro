---
import { Image } from "astro:assets";
import ProductArt from "./ProductArt.astro";
import { products } from "../data/products";
import { withBase } from "../lib/paths";
import risenLogo from "../assets/brands/risen-logo.png";
import risenCiEssCard from "../assets/products/risen-ci-ess-card.jpg";
import suntechLogo from "../assets/brands/suntech-logo.png";
import lvLogoUrl from "../assets/brands/lithiumvalley-logo.svg?url";
import projoyLogo from "../assets/brands/projoy-logo.png";

const restProducts = products.filter(
  (p) => p.slug !== "monocrystalline-pv-module" && p.slug !== "risen-ci-energy-storage"
);

---

<section id="products" class="relative bg-gradient-to-b from-white to-ice-100/40 py-24 sm:py-32">
  <div class="container-page">
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <span class="eyebrow border-azure-500/20 text-azure-600" data-i18n="products.eyebrow">Τα Προϊόντα Μας</span>
      <h2 class="mt-5 font-display text-3xl font-extrabold tracking-tight text-navy-900 sm:text-4xl" data-i18n="products.h2">
        Πλήρης γκάμα εξοπλισμού για κάθε φωτοβολταϊκό έργο
      </h2>
      <p class="mt-4 text-lg text-navy-900/60" data-i18n="products.desc">
        Από πάνελ υψηλής απόδοσης έως συστήματα αποθήκευσης και φόρτισης — επιλεγμένα προϊόντα
        από κορυφαίους παγκόσμιους κατασκευαστές.
      </p>
    </div>

    <div class="mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {/* Risen Panel — hardcoded styled card */}
      {(() => {
        const p = products[0];
        return (
          <a href={withBase("products/risen-hyper-ion/")} class="group relative overflow-hidden rounded-3xl border border-navy-900/8 bg-white shadow-card transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_24px_48px_-16px_rgba(47,127,224,0.25)]" data-reveal>
            <div class="flex h-56 items-center justify-center gap-4 px-4 overflow-hidden bg-gradient-to-br from-ice-100 to-white">
              <Image src={p.photo!} alt={p.name} width={200} height={270} class="h-48 w-auto object-contain transition-transform duration-500 group-hover:scale-105" />
              <div class="h-20 w-px bg-navy-900/10 shrink-0" />
              <Image src={risenLogo} alt="Risen Energy" width={160} height={80} class="h-14 w-auto object-contain opacity-85 transition-transform duration-500 group-hover:scale-105" />
            </div>
            <div class="p-8 pt-6">
              <p class="text-xs font-bold tracking-[0.14em] text-azure-600 uppercase">{p.tag}</p>
              {p.distributor && <p class="mt-1.5 text-[11px] font-extrabold tracking-[0.12em] text-navy-900/75 uppercase">{p.distributor}</p>}
              <h3 class="mt-3 font-display text-xl font-bold text-navy-900">{p.name}</h3>
              <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-azure-600">
                <span data-i18n="products.more">Περισσότερα</span>
                <svg class="h-3.5 w-3.5 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
              </span>
            </div>
          </a>
        );
      })()}

      {/* Risen Storage — hardcoded */}
      <a href={withBase("products/risen-ci-energy-storage/")} class="group relative overflow-hidden rounded-3xl border border-navy-900/8 bg-white shadow-card transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_24px_48px_-16px_rgba(47,127,224,0.25)]" data-reveal>
        <div class="flex h-56 items-center justify-center overflow-hidden bg-gradient-to-br from-ice-100 to-white">
          <Image src={risenCiEssCard} alt="Risen Energy Storage" width={340} height={420} class="h-52 w-auto object-contain transition-transform duration-500 group-hover:scale-105" />
        </div>
        <div class="p-8 pt-6">
          <p class="text-xs font-bold tracking-[0.14em] text-azure-600 uppercase">Risen Storage</p>
          <p class="mt-1.5 text-[11px] font-extrabold tracking-[0.12em] text-navy-900/75 uppercase">ΕΠΙΣΗΜΟΣ ΔΙΑΝΟΜΕΑΣ RISEN ENERGY</p>
          <h3 class="mt-3 font-display text-xl font-bold text-navy-900">Αποθήκευση Ενέργειας</h3>
          <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-azure-600">
            <span data-i18n="products.more">Περισσότερα</span>
            <svg class="h-3.5 w-3.5 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </span>
        </div>
      </a>

      {/* Suntech — hardcoded */}
      <a href={withBase("products/suntech-ultra-t2/")} class="group relative overflow-hidden rounded-3xl border border-navy-900/8 bg-white shadow-card transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_24px_48px_-16px_rgba(47,127,224,0.25)]" data-reveal>
        <div class="flex h-40 items-center justify-center overflow-hidden bg-gradient-to-br from-ice-100 to-white">
          <Image src={suntechLogo} alt="Suntech Solar Panels" width={340} height={220} class="h-32 w-auto max-w-[85%] object-contain transition-transform duration-500 group-hover:scale-105" />
        </div>
        <div class="p-8 pt-6">
          <p class="text-xs font-bold tracking-[0.14em] text-azure-600 uppercase">Suntech</p>
          <p class="mt-1.5 text-[11px] font-extrabold tracking-[0.12em] text-navy-900/75 uppercase">ΦΩΤΟΒΟΛΤΑΪΚΑ ΠΑΝΕΛ</p>
          <h3 class="mt-3 font-display text-xl font-bold text-navy-900">Πάνελ</h3>
          <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-azure-600">
            <span data-i18n="products.more">Περισσότερα</span>
            <svg class="h-3.5 w-3.5 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </span>
        </div>
      </a>

      {/* Rest of products from array */}
      {
        restProducts.map((p, i) => (
          <a
            href={withBase(p.slug === "pv-storage-batteries" ? "products/lithiumvalley-residential/" : `products/${p.slug}/`)}
            class="group relative overflow-hidden rounded-3xl border border-navy-900/8 bg-white shadow-card transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_24px_48px_-16px_rgba(47,127,224,0.25)]"
            data-reveal
            style={`transition-delay:${(i + 3) * 60}ms`}
          >
            <div class={`overflow-hidden bg-gradient-to-br from-ice-100 to-white ${p.slug === "ev-chargers" ? "flex h-56 items-center justify-center" : p.slug === "firefighter-safety-switch" ? "flex h-40 items-center justify-center gap-3 px-4" : "h-40"}`}>
              {p.photo ? (
                p.slug === "ev-chargers" ? (
                  <Image src={p.photo} alt={p.name} width={340} height={504} class="h-52 w-auto object-contain transition-transform duration-500 group-hover:scale-105" />
                ) : p.slug === "firefighter-safety-switch" ? (
                  <>
                    <Image src={p.photo} alt={p.name} width={160} height={175} class="h-32 w-auto object-contain transition-transform duration-500 group-hover:scale-105" />
                    <div class="h-16 w-px bg-navy-900/10 shrink-0" />
                    <Image src={projoyLogo} alt="Projoy Electric" width={160} height={60} class="h-12 w-auto object-contain opacity-85 transition-transform duration-500 group-hover:scale-105" />
                  </>
                ) : (
                  <Image src={p.photo} alt={p.name} width={340} height={p.slug === "pv-storage-batteries" ? 190 : 590} class="h-full w-full object-contain transition-transform duration-500 group-hover:scale-105" />
                )
              ) : (
                <div class="flex h-full items-center justify-center">
                  <ProductArt kind={p.art!} class="h-32 w-auto transition-transform duration-500 group-hover:scale-105" />
                </div>
              )}
            </div>
            <div class="p-8 pt-6">
              <p class="text-xs font-bold tracking-[0.14em] text-azure-600 uppercase">{p.tag}</p>
              {p.slug === "pv-storage-batteries" && (
                <img src={lvLogoUrl} alt="Lithium Valley" class="mt-2 h-5 w-auto opacity-90" />
              )}
              {p.slug === "firefighter-safety-switch" && (
                <p class="mt-1.5 text-[11px] font-extrabold tracking-[0.12em] text-navy-900/75 uppercase">PROJOY</p>
              )}
              {p.distributor && <p class="mt-1.5 text-[11px] font-extrabold tracking-[0.12em] text-navy-900/75 uppercase">{p.distributor}</p>}
              <h3 class="mt-3 font-display text-xl font-bold text-navy-900">{p.name}</h3>
              <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-azure-600">
                <span data-i18n="products.more">Περισσότερα</span>
                <svg class="h-3.5 w-3.5 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>
